        def set_button(self, kind):
            """The Start / Stop / Resume button: icon, text, colour (white text on the accent)."""
            icon, key, cls = {"start": ("system-search-symbolic", "L_SCN_START", "primary"),
                              "stop": ("media-playback-stop-symbolic", "L_SCN_STOP", "danger"),
                              "resume": ("media-playback-start-symbolic", "L_SCN_RESUME", "primary")}[kind]
            for c in ("primary", "danger"):
                self.toggle.remove_css_class(c)
            self.toggle.add_css_class(cls)
            box = Gtk.Box(spacing=6)
            box.append(Gtk.Image.new_from_icon_name(icon))
            box.append(Gtk.Label(label=T(key)))
            self.toggle.set_child(box)

        def update_estimate(self):
            bands = [b for b in self.bands if b.enabled]
            n = sum(sum(1 for _ in b.hops()) for b in bands)
            k = max(1, sum(1 for d in self.devices if d["enabled"]))
            self.estimate.set_text(P("L_SCN_ESTIMATE", n, n, duration(0, ScanState(bands).estimate() / k)) +
                                   (T("L_SCN_ESTIMATE_DEVS", k) if k > 1 else "")
                                   if n else T("L_SCN_NO_RANGE_CHECKED"))

        def update_ranges_btn(self):
            n = sum(1 for b in self.bands if b.enabled)
            self.ranges_btn.get_child().get_last_child().set_label(P("L_SCN_RANGES_BTN", n, n))
            self.update_estimate()
            if hasattr(self, "f_range"):
                self.rebuild_range_filters()

        def lock_ranges(self, locked):
            for w in (self.ranges_btn, self.dwell, self.threshold, self.dev_box, self.preset_btn):
                w.set_sensitive(not locked)

        # Receivers ----------------------------------------------------------------------------------
        def rebuild_devices(self):
            self.devices = receivers()
            box = self.dev_box
            clear(box)
            if not self.devices:
                box.append(label(T("L_SCN_NO_DEVICE"), ["dim"]))
            for d in self.devices:
                chip = Gtk.Box(spacing=2)
                chip.add_css_class("chip")
                cb = Gtk.CheckButton()
                hf = d["hf"] if d["hf"] is not None else d["tuner"] == 6 or "Blog V3" in d["label"]
                cov = coverage_text(d["tuner"], hf) or T("L_SCN_DEV_TUNER_UNKNOWN")
                check_label(cb, "%s\n%s" % (d["label"], cov), css=["dim"] if not d["enabled"] else [],
                            max_width_chars=28)
                cb.set_active(d["enabled"])
                cb.set_tooltip_text(T("L_SCN_DEV_TIP") + "\n" + T("L_SCN_DEV_LINE", d["serial"] or "-", cov))
                cb.connect("toggled", lambda w, d=d: self.toggle_device(d, w.get_active()))
                chip.append(cb)
                bt = Gtk.Button(icon_name="document-edit-symbolic", valign=Gtk.Align.CENTER,
                                tooltip_text=T("L_SCN_EDIT"))
                bt.add_css_class("flat")
                bt.connect("clicked", lambda _w, d=d: self.edit_device(d))
                chip.append(bt)
                box.append(chip)
            refresh = Gtk.Button(icon_name="view-refresh-symbolic", valign=Gtk.Align.CENTER,
                                 tooltip_text=T("L_SCN_DEVICES_REFRESH"))
            refresh.add_css_class("flat")
            refresh.connect("clicked", lambda *_: self.rebuild_devices())
            box.append(refresh)
            self.update_estimate()

        def toggle_device(self, d, active):
            d["enabled"] = active
            update_device_conf(d["id"], enabled=active)
            self.rebuild_devices()

