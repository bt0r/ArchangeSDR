        # Cards ---------------------------------------------------------------------------------------
        def set_cards(self, devs):
            """One "current scan" card per receiver; a single one, without a title, when idle."""
            grid = self.cards_grid
            clear(grid)
            self.cards = {}
            cols = 1 if len(devs) <= 1 else 2
            for i, d in enumerate(devs or [None]):
                c = types.SimpleNamespace(spectrum=None, signals=[], dev=d["id"] if d else None)
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
                box.add_css_class("card")
                if len(devs) > 1:
                    box.append(label(d["label"], ["dim", "params"], ellipsize=Pango.EllipsizeMode.END, width_chars=10))
                c.status = label(T("L_SCN_STOPPED"), ["status-title"], ellipsize=Pango.EllipsizeMode.END,
                                 width_chars=10)
                c.substatus = label("", ["dim"], wrap=True)
                c.progress = Gtk.ProgressBar()
                c.area = Gtk.DrawingArea(content_height=150 if len(devs) <= 2 else 100, hexpand=True)
                c.area.set_draw_func(lambda a, cr, w, h, c=c: self.draw_spectrum(c, a, cr, w, h))
                for w in (c.status, c.substatus, c.progress, c.area):
                    box.append(w)
                grid.attach(box, i % cols, i // cols, 1, 1)
                self.cards[c.dev] = c
            first = next(iter(self.cards.values()))
            self.status, self.substatus, self.progress = first.status, first.substatus, first.progress

        def card(self, dev):
            return self.cards.get(dev) or next(iter(self.cards.values()))

        # Scan ----------------------------------------------------------------------------------------
        def running(self):
            return any(sc.is_alive() for sc in self.scanners)

        def on_toggle(self, *_):
            if self.running():
                self.stop_scan()
            elif self.state is not None:
                self.run_scanner()          # resume after "Join"
            else:
                self.start_scan()

        def start_scan(self):
            bands = [b for b in self.bands if b.enabled]
            if not bands:
                self.substatus.set_text(T("L_SCN_CHECK_ONE"))
                return
            self.rebuild_devices()
            if not self.devices:
                self.substatus.set_text(T("L_SCN_ERR_NO_DONGLE"))
                return
            self.scan_devs = [d for d in self.devices if d["enabled"]]
            if not self.scan_devs:
                self.substatus.set_text(T("L_SCN_CHECK_DEVICE"))
                return
            self.state = ScanState(bands, dwell=self.dwell.get_value(), threshold=self.threshold.get_value())
            self.run_scanner()

        def run_scanner(self):
            # The dongles serve only one app at a time: free what the SDR menu or "Join" started
            for p in ("gqrx", "sdrpp", "rtl_fm", "rtl_power", "rtl_433", "rtl_airband", "acarsdec", "dumpvdl2",
                      "AIS-catcher", "direwolf", "welle-io", "satdump", "satdump-ui"):
                run_quiet(["pkill", "-x", p])
            # Python programs: their process name is python3, match the command line (neither pattern
            # appears in this script's own command line)
            self.stop_joined()
            for pattern in ("auto_rx.py", "scripts/band-scan"):
                run_quiet(["pkill", "-f", pattern])
            time.sleep(0.5)
            # a dongle plugged in another port since the pause has another index: found again by its id
            plugged = {d["id"]: d for d in receivers()}
            devs = [dict(d, index=plugged[d["id"]]["index"]) for d in self.scan_devs if d["id"] in plugged]
            missing = [d["label"] for d in self.scan_devs if d["id"] not in plugged]
            if not devs:
                self.substatus.set_text(T("L_SCN_DEV_MISSING", ", ".join(missing)))
                return
            self.state.paused = False
            self.state.errors = []
            self.set_cards(devs)
            idle = lambda fn: (lambda *a: GLib.idle_add(lambda: fn(*a) and False))
            self.scanners = [Scanner(self.state, self.store, d, callbacks={
                "on_start": idle(self.on_start), "on_tune": idle(self.on_tune), "on_window": idle(self.on_window),
                "on_hit": idle(self.on_hit), "on_record": idle(self.on_record), "on_end": idle(self.on_end)})
                for d in devs]
            for sc in self.scanners:
                sc.start()
                self.card(sc.dev).status.set_text(T("L_SCN_OPENING"))
            if missing:
                self.substatus.set_text(T("L_SCN_DEV_MISSING", ", ".join(missing)))
            self.set_button("stop")
            self.end_btn.set_visible(False)
            self.lock_ranges(True)

        def stop_scan(self):
            for sc in self.scanners:
                if sc.is_alive():
                    sc.stop()
                    self.card(sc.dev).status.set_text(T("L_SCN_STOPPING"))

        def pause_scan(self, then=None):
            """Frees the dongles while keeping the sweep plan; then() is called once they are free."""
            if then:
                self.after_stop.append(then)
            if self.running():
                for sc in self.scanners:
                    if sc.is_alive():
                        sc.pause()
                        self.card(sc.dev).status.set_text(T("L_SCN_PAUSING"))
            else:
                todo, self.after_stop = self.after_stop, []
                for fn in todo:
                    fn()

        def finish_paused(self):
            st = self.state
            if st is not None and not self.running():
                self.store.end_scan(st.scan_id, st.passes, st.done)
            self.state = None
            self.scanners = []
            self.end_scan_ui(None)

        def on_usr1(self):
            self.pause_scan()     # another app needs the dongle: the scan can be resumed
            return True

        def on_start(self, dev, scan_id, name):
            self.card(dev).substatus.set_text(T("L_SCN_SCAN_DONGLE", scan_id, name or "RTL-SDR"))
            self.refresh_lists()

        def on_tune(self, dev, band, lo, hi, i, n, passes, phase):
            c = self.card(dev)
            c.status.set_markup('<span foreground="#%s">●</span> %s %s – %s  ·  %s' % (
                self.accent_hex(), GLib.markup_escape_text(T({"survey": "L_SCN_PHASE_SURVEY",
                                                              "record": "L_SCN_PHASE_RECORD",
                                                              "revisit": "L_SCN_PHASE_REVISIT"}
                                                             .get(phase, "L_SCN_PHASE_LISTEN"))),
                fmt_mhz(lo, 3), fmt_mhz(hi, 3), GLib.markup_escape_text(band.label or band.section)))
            c.progress.set_fraction(i / n)
            c.progress.set_text(T("L_SCN_PROGRESS", passes + 1, i + 1, n))
            c.progress.set_show_text(True)

        def on_window(self, dev, band, lo, hi, spectrum, signals, ignored):
            c = self.card(dev)
            c.spectrum, c.signals = (spectrum, lo, hi), signals
            voice = sum(s["voice"] for s in signals)
            n = len(signals)
            sid = self.state.scan_id if self.state else 0
            if band.mode == "WFM":
                c.substatus.set_text(P("L_SCN_SUB_STATIONS", n, sid, n))
            elif signals and signals[0].get("candidate"):
                todo = sum(not x["quiet"] for x in signals)
                c.substatus.set_text(P("L_SCN_SUB_SPOTTED", n, sid, n) + T("L_SCN_SUB_TODO", todo) +
                                     P("L_SCN_SUB_MUTED", n - todo, n - todo))
            else:
                c.substatus.set_text(P("L_SCN_SUB_SIGNALS", n, sid, n, voice) +
                                     P("L_SCN_SUB_IGNORED", ignored, ignored))
            c.area.queue_draw()
            if self.f_parasites.get_active() and n > voice and not signals[0].get("candidate"):
                self.refresh_lists()

        def on_hit(self, dev, sig, band, new):
            if new and not sig.get("station"):     # no alert for every FM radio
                title = T("L_SCN_NOTIFY_TITLE", fmt_mhz(sig["freq"]))
                body = "%s · %s · +%.0f dB" % (band.label or band.section, sig["mode"], sig["snr"])
                if len(self.scanners) > 1:
                    body += " · " + next((d["label"] for d in self.scan_devs if d["id"] == dev), dev)
                notify(title, body)
                self.show_banner(title, body)
            self.refresh_lists()

        def on_record(self, dev, band, lo, hi, spectrum, signals, recs, done):
            if done:
                self.refresh_lists()      # the "Play recording" buttons
                return
            c = self.card(dev)
            c.spectrum, c.signals = (spectrum, lo, hi), signals
            c.substatus.set_text(" · ".join(
                T("L_SCN_SUB_RECORDING", fmt_mhz(f), fmt_secs(seconds)) +
                (T("L_SCN_SUB_REC_SILENT", silent, RECORD_SILENCE_S) if silent >= 1 else "")
                if live else T("L_SCN_SUB_REC_DONE", fmt_mhz(f), fmt_secs(seconds))
                for f, seconds, silent, live in recs))
            c.area.queue_draw()

        def show_banner(self, title, body):
            """Shows the latest new active frequency at the top of the window for 15 s."""
            self.banner_title.set_text(title)
            self.banner_body.set_text(body)
            self.banner.set_reveal_child(True)
            if self.banner_timer:
                GLib.source_remove(self.banner_timer)

            def hide():
                self.banner_timer = None
                self.banner.set_reveal_child(False)
                return False
            self.banner_timer = GLib.timeout_add_seconds(15, hide)

        def on_end(self, dev, error, paused):
            c = self.card(dev)
            if error:                 # this receiver stops, the others carry on
                c.status.set_text(T("L_SCN_DEV_STOPPED"))
                c.substatus.set_text(T("L_SCN_ERROR", error))
            if self.running():
                return
            st = self.state
            if st is not None and st.paused and not (st.errors and len(st.errors) == len(self.scanners)):
                self.set_button("resume")
                self.end_btn.set_visible(True)
                for c in self.cards.values():
                    if not c.status.get_text().startswith(T("L_SCN_DEV_STOPPED")):
                        c.status.set_text(T("L_SCN_PAUSED", st.scan_id))
                        c.substatus.set_text(T("L_SCN_RESUME_HINT", st.passes + 1))
                self.refresh_lists()
            else:
                self.state = None
                self.end_scan_ui(error)
            todo, self.after_stop = self.after_stop, []
            for fn in todo:
                fn()

        def end_scan_ui(self, error):
            self.set_button("start")
            self.end_btn.set_visible(False)
            for c in self.cards.values():
                c.progress.set_fraction(0)
                c.progress.set_show_text(False)
                if not c.status.get_text().startswith(T("L_SCN_DEV_STOPPED")):
                    c.status.set_text(T("L_SCN_STOPPED"))
            self.lock_ranges(False)
            self.refresh_lists()

        def tick(self):
            # playback ends; every 15 s the journal is checked (an "active" badge goes; redrawn only if changed)
            if self.player and self.player[0].poll() is not None:
                self.player = None
                self.refresh_lists()
            elif time.time() - self.last_journal > 15:
                self.refresh_lists()
            return True

        # Join / play back ----------------------------------------------------------------------------
        def join_conf(self):
            return self.settings.setdefault("join", {})

        def join_programs(self):
            """[(id, name, available)]: the built-in ones, then the user's commands ("cmd:<n>")."""
            out = [(pid, name, bool(shutil.which(exe))) for pid, name, exe in JOIN_PROGRAMS]
            for i, c in enumerate(self.join_conf().get("commands", [])):
                if c.get("command"):
                    out.append(("cmd:%d" % i, c.get("name") or T("L_SCN_JOIN_CMD_N", i + 1), True))
            return out

        def join_default(self):
            ids = [p[0] for p in self.join_programs()]
            pid = self.join_conf().get("program", "gqrx")
            return pid if pid in ids else "gqrx"

        def join(self, freq, mode, device=None, program=None):
            """Pauses the scan (the dongle is freed) and opens the frequency in the program chosen, on the
            receiver that heard it (its index now)."""
            self.stop_clip()
            program = program or self.join_default()
            name = dict((p[0], p[1]) for p in self.join_programs()).get(program, program)
            if self.running():
                self.substatus.set_text(T("L_SCN_JOINING", fmt_mhz(freq), mode, name))
            dev = next((d for d in list_devices() if d["id"] == device), None)
            index = dev["index"] if dev else None
            gain = load_device_conf().get(device or "", {}).get("gain")
            values = join_values(freq, mode, index, dev["serial"] if dev else None, gain)

            def start():
                ok = True
                if program == "gqrx":
                    ok = open_gqrx(freq, mode, index)
                elif program == "sdrpp":
                    ok = open_sdrpp(freq, mode)
                else:
                    if program == "rtl_fm":
                        command = RTL_FM_COMMAND
                    else:
                        cmds = self.join_conf().get("commands", [])
                        k = int(program.split(":")[1])
                        command = cmds[k]["command"] if k < len(cmds) else ""
                    self.join_proc = run_command(fill_template(command, values)) if command else None
                    ok = self.join_proc is not None
                if not ok:
                    self.substatus.set_text(T("L_SCN_JOIN_FAILED", name))
            self.pause_scan(then=start)

        def stop_joined(self):
            """The command "Join" started (rtl_fm, a user command) stops when the scan resumes: the dongle."""
            proc, self.join_proc = getattr(self, "join_proc", None), None
            if proc and proc.poll() is None:
                try:
                    os.killpg(proc.pid, signal.SIGTERM)
                except OSError:
                    pass

        def join_button(self, r):
            """Join (the default program) and ▾ for another one."""
            box = Gtk.Box(valign=Gtk.Align.CENTER)
            box.add_css_class("linked")
            name = dict((p[0], p[1]) for p in self.join_programs()).get(self.join_default(), "")
            bt = Gtk.Button(label=T("L_SCN_JOIN"))
            bt.add_css_class("listen")
            bt.set_tooltip_text(T("L_SCN_JOIN_TIP", fmt_mhz(r["freq"]), r["mode"], name))
            bt.connect("clicked", lambda *_: self.join(r["freq"], r["mode"], r["device"]))
            box.append(bt)
            menu = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=6, margin_bottom=6,
                           margin_start=6, margin_end=6)
            pop = Gtk.Popover(child=menu)
            for pid, pname, available in self.join_programs():
                item = Gtk.Button(label=pname if available else T("L_SCN_JOIN_MISSING", pname), sensitive=available)
                item.add_css_class("flat")
                item.get_child().set_xalign(0)
                item.connect("clicked", lambda _w, pid=pid: (pop.popdown(),
                                                             self.join(r["freq"], r["mode"], r["device"], pid)))
                menu.append(item)
            more = Gtk.MenuButton(popover=pop, icon_name="pan-down-symbolic", tooltip_text=T("L_SCN_JOIN_WITH"))
