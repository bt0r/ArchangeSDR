NTFY_MAX_ATTACH = 15_000_000     # ntfy.sh's attachment limit


def ntfy_conf():
    """{enabled, url (https://ntfy.sh/<topic> or a server of one's own), token, min_score_on, min_score,
    freqs_on, freqs, attach}."""
    return load_settings().get("ntfy", {})


def parse_freqs(text):
    """'145.5, 446.0-446.2' (MHz) → [(lo, hi)] in Hz; a single frequency counts ±MERGE_HZ."""
    out = []
    for tok in re.split(r"[;\s]+|,(?!\d)", text or ""):     # "145,5": a decimal comma, not a separator
        m = re.fullmatch(r"(\d+(?:[.,]\d+)?)(?:-(\d+(?:[.,]\d+)?))?", tok)
        if m:
            a = float(m.group(1).replace(",", ".")) * 1e6
            b = float(m.group(2).replace(",", ".")) * 1e6 if m.group(2) else None
            out.append((min(a, b), max(a, b)) if b else (a - MERGE_HZ, a + MERGE_HZ))
    return out


def ntfy_wanted(conf, freq, score):
    """Does this recording pass the notification conditions (none ticked: every one)?"""
    if conf.get("min_score_on") and (score or 0) < float(conf.get("min_score", 1.0)):
        return False
    if conf.get("freqs_on"):
        return any(lo <= freq <= hi for lo, hi in parse_freqs(conf.get("freqs")))
    return True


def ntfy_send(conf, title, message, attach=None):
    """Publishes on the ntfy topic (POST, or PUT with the file attached); RuntimeError if it fails."""
    import urllib.error
    import urllib.parse
    import urllib.request
    url = (conf.get("url") or "").strip()
    if not re.match(r"https?://[^/]+/.+", url):
        raise RuntimeError(T("L_SCN_NTFY_ERR_URL"))
    params = {"title": title, "tags": "radio"}
    if attach:
        params.update(message=message, filename=os.path.basename(attach))
        data, method = open(attach, "rb").read(), "PUT"
    else:
        data, method = message.encode("utf-8"), "POST"
    req = urllib.request.Request(url + ("&" if "?" in url else "?") + urllib.parse.urlencode(params), data=data,
                                 method=method)
    if conf.get("token"):
        req.add_header("Authorization", "Bearer " + conf["token"])
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            r.read()
    except urllib.error.HTTPError as e:
        raise RuntimeError(T("L_SCN_TR_ERR_HTTP", e.code, e.read().decode("utf-8", "replace")[:200].strip()))
    except (urllib.error.URLError, OSError) as e:
        raise RuntimeError(T("L_SCN_TR_ERR_NET", getattr(e, "reason", e)))


NTFY_LAST = {}    # the last sending: {"time", "error"} (shown in the settings)


def notify_recording(store, did):
    """A finished recording, on the phone (ntfy) if the settings want it. Runs in a thread of its own."""
    conf = ntfy_conf()
    if not conf.get("enabled") or not conf.get("url"):
        return
    rows = store.q("SELECT freq, mode, label, score, snr, rec_s, recording, device FROM detections WHERE id = ?",
                   (did,))
    if not rows:
        return
    freq, mode, lbl, score, snr, rec_s, recording, device = rows[0]
    if not ntfy_wanted(conf, freq, score):
        return
    dev = load_device_conf().get(device or "", {})
    message = T("L_SCN_NTFY_MSG", fmt_secs(rec_s or 0), score or 0, snr or 0, mode,
                dev.get("label") or dev.get("name") or device or "RTL-SDR", fmt_time(time.time(), CLOCK_FMT))
    attach = recording if conf.get("attach") and recording and os.path.exists(recording) and \
        os.path.getsize(recording) <= NTFY_MAX_ATTACH else None
    try:
        ntfy_send(conf, "%s · %s" % (fmt_mhz(freq), lbl or mode), message, attach)
        NTFY_LAST.update(time=time.time(), error=None)
    except (RuntimeError, OSError) as e:
        NTFY_LAST.update(time=time.time(), error=str(e))


# --- Terminal mode -------------------------------------------------------------------------------

def cli(args):
    m = re.match(r"([\d.]+)-([\d.]+)$", args[0]) if args else None
    if not m:
        print(T("L_SCN_USAGE"))
        sys.exit(1)
    lo, hi = float(m.group(1)) * 1e6, float(m.group(2)) * 1e6
    known = [b for b in load_ranges() if b.lo <= lo < b.hi]
    mode = known[0].mode if known else "NFM"
    passes = int(args[args.index("--passes") + 1]) if "--passes" in args else 1
    band = Band(lo, hi, "%s - %s MHz" % (m.group(1), m.group(2)), mode, "")
    # --device a,b: these receivers (index, serial or id), else the enabled ones of the receivers file
    devs = receivers()
    if "--device" in args:
        wanted = args[args.index("--device") + 1].split(",")
        devs = [d for d in devs if wanted and {str(d["index"]), d["serial"], d["id"]} & set(wanted)]
    else:
        devs = [d for d in devs if d["enabled"]] or devs[:1]
    if not devs:
        print(T("L_SCN_ERR_NO_DONGLE"))
        sys.exit(1)
    labels = {d["id"]: d["label"] for d in devs}
    out_lock = threading.Lock()

    def say(dev, text):
        with out_lock:
            print(("[%s] " % labels[dev] if len(devs) > 1 else "") + text)

    def on_window(dev, band, lo, hi, spectrum, signals, ignored):
        lines = [T("L_SCN_CLI_WINDOW", fmt_mhz(lo, 3), fmt_mhz(hi, 3), len(signals),
                   T("L_SCN_CLI_CONTINUOUS", ignored) if ignored else "")]
        for s in signals:
            if s.get("candidate"):
                lines.append(T("L_SCN_CLI_CANDIDATE", fmt_mhz(s["freq"]), s["snr"], T("L_SCN_CLI_BANNED")
                               if s["banned"] else T("L_SCN_CLI_MUTED") if s["quiet"] else ""))
                continue
            f = s.get("features") or (0, 0, 0, 0)
            lines.append(T("L_SCN_CLI_SIGNAL",
                           fmt_mhz(s["freq"]), s["snr"], 100 * s["occupancy"], s["demod"] or "-", s["score"], *f,
                           T("L_SCN_CLI_WHITE") if s.get("whitelisted") else
                           T("L_SCN_CLI_VOICE") if s["voice"] else T("L_SCN_CLI_STATION") if s.get("station")
                           else T("L_SCN_CLI_PARASITE", s.get("reason") or "")))
        say(dev, "\n".join(lines))

    def on_record(dev, band, lo, hi, spectrum, signals, recs, done):
        if done:
            for f, seconds, _, _ in recs:
                say(dev, T("L_SCN_CLI_RECORDED", fmt_mhz(f), fmt_secs(seconds)))

    state = ScanState([band], dwell=float(os.environ.get("SCAN_DWELL", 2.5)),
                      threshold=float(os.environ.get("SCAN_THRESHOLD", 8)), max_passes=passes)
    store = Store()
    scanners = [Scanner(state, store, d, callbacks={
        "on_window": on_window, "on_record": on_record,
        "on_start": lambda dev, i, n: say(dev, T("L_SCN_CLI_START", n, i)),
        "on_end": lambda dev, e, paused: say(dev, e or T("L_SCN_CLI_END"))}) for d in devs]
    signal.signal(signal.SIGINT, lambda *a: [sc.stop() for sc in scanners])
    for sc in scanners:
        sc.start()
    while any(sc.is_alive() for sc in scanners):
        for sc in scanners:
            sc.join(0.2)


