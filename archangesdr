def load_settings():
    """The app's own settings (the Settings tab). They override the language and region of the desktop's
    file, which the app never writes. API keys live here too: the file is readable by its owner only."""
    try:
        data = json.load(open(SETTINGS, encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_settings(data):
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    tmp = SETTINGS + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, SETTINGS)


def read_conf():
    """Settings of the profile's file (bash KEY=value); the environment fills in a setting the file does
    not set. LANG and REGION are the profile's language and region keys, read under their own names."""
    keys = {"SDR_DEVICE": "0", "SDR_GAIN": "40", "SDR_ASYNC": "1", "RADIO_WS": PROFILE.get("ws", ""),
            PROFILE["lang_key"]: PROFILE["lang"], PROFILE["region_key"]: PROFILE["region"]}
    conf = {k: os.environ.get(k) or v for k, v in keys.items()}
    try:
        for line in open(PROFILE["conf"]):
            m = re.match(r"\s*([A-Z_]+)=[\"']?([^\"'#\s]*)", line)
            if m and m.group(1) in conf and m.group(2):
                conf[m.group(1)] = m.group(2)
    except OSError:
        pass
    conf["LANG"] = conf[PROFILE["lang_key"]] if conf[PROFILE["lang_key"]] in LANGS else "en"
    conf["REGION"] = conf[PROFILE["region_key"]]
    app = load_settings()
    if app.get("lang") in LANGS:
        conf["LANG"] = app["lang"]
    if app.get("region"):
        conf["REGION"] = app["region"]
    return conf


