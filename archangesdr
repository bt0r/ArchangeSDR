def T(key, *args):
    """UI string of the language files, %-formatted when arguments are given."""
    s = STRINGS.get(key, key)
    return s % args if args else s


def P(key, n, *args):
    """Singular (key_1) or plural (key_N) form for the count n. 0 takes the singular, as in French,
    unless the language file sets L_SCN_ZERO_PLURAL=1."""
    plural = n > 1 or (n == 0 and T("L_SCN_ZERO_PLURAL") == "1")
    return T(key + ("_N" if plural else "_1"), *args)


