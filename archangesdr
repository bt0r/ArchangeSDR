                  "| aplay -q -t raw -f S16_LE -c 1 -r <audio_rate>")
RIGCTL_MODES = {"NFM": ("FM", 12500), "FM": ("FM", 12500), "WFM": ("WFM", 150000), "AM": ("AM", 10000),
                "USB": ("USB", 2800), "LSB": ("LSB", 2800)}
JOIN_TOKENS = ("frequency", "frequency_khz", "frequency_mhz", "mode", "mode_lower", "rtl_mode", "rtl_rate",
               "audio_rate", "device", "serial", "gain")


def join_values(freq, mode, device=None, serial=None, gain=None):
    """The values of a command template: <frequency> (Hz), <frequency_khz>, <frequency_mhz>, <mode> (NFM, AM,
    USB, LSB, WFM, FM), <mode_lower>, <rtl_mode> (fm, am, usb, lsb, wbfm), <rtl_rate>, <audio_rate>,
    <device> (USB index), <serial>, <gain> (dB)."""
    rtl = RTL_MODES.get(mode, "fm")
    return {"frequency": "%d" % round(freq), "frequency_khz": "%.3f" % (freq / 1e3),
            "frequency_mhz": "%.6f" % (freq / 1e6), "mode": mode, "mode_lower": mode.lower(), "rtl_mode": rtl,
            "rtl_rate": "200000" if rtl == "wbfm" else "24000", "audio_rate": "48000" if rtl == "wbfm" else "24000",
            "device": "%s" % (device if device is not None else CONF["SDR_DEVICE"]), "serial": serial or "",
            "gain": "%g" % float(gain if gain is not None else CONF["SDR_GAIN"] or 40)}


def fill_template(template, values):
    """<name> replaced by its value, quoted for the shell; an unknown <name> stays as it is."""
    return re.sub(r"<([a-z_]+)>", lambda m: shlex.quote(values[m.group(1)]) if m.group(1) in values else m.group(0),
                  template)


def run_command(command):
    """A user command through the shell (pipes allowed), in its own process group (stopped with the scan's
    resume). The Popen, or None if it cannot start."""
    try:
        return subprocess.Popen(["sh", "-c", command], start_new_session=True, stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL)
    except OSError:
        return None


def open_sdrpp(freq, mode):
    """SDR++ started, then tuned through its Rigctl Server (127.0.0.1:4532) once it answers."""
    if not launch(["sdrpp"], read_conf()["RADIO_WS"]):
        return False
    name, width = RIGCTL_MODES.get(mode, RIGCTL_MODES["NFM"])

    def remote():
        for _ in range(60):
            time.sleep(0.5)
            try:
                with socket.create_connection(("127.0.0.1", 4532), timeout=2) as s:
                    for cmd in ("F %d" % int(freq), "M %s %d" % (name, width)):
                        s.sendall((cmd + "\n").encode())
                        s.recv(64)
                return
            except OSError:
                continue
    threading.Thread(target=remote, daemon=True).start()
    return True


