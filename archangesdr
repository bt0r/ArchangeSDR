                install.set_visible(not installed(f) and self.downloading is None)
                remove.set_visible(installed(f))
                if installed(f) and wmodel.get_text() != path:
                    wmodel.set_text(path)         # an installed model is the one used
            model_dd.connect("notify::selected", model_changed)

            def refresh_models():
                sel = model_dd.get_selected()
                model_dd.set_model(Gtk.StringList.new(model_items()))
                model_dd.set_selected(sel)
                model_changed()

            def start_download(*_):
                name, f, mb = WHISPER_MODELS[model_dd.get_selected()]
                stop = threading.Event()
                self.downloading = stop
                install.set_visible(False)
                model_dd.set_sensitive(False)
                progress_box.set_visible(True)
                bar.set_fraction(0)
                bar.set_text(T("L_SCN_SET_TR_DL_PROGRESS", size_text(0), size_text(mb)))

                def progress(got, total):
                    def show():
                        bar.set_fraction(got / total if total else 0)
                        bar.set_text(T("L_SCN_SET_TR_DL_PROGRESS", size_text(got / 1e6),
                                       size_text((total or mb * 1e6) / 1e6)))
                    GLib.idle_add(lambda: show() and False)

                def finished(path, error):
                    def show():
                        self.downloading = None
                        progress_box.set_visible(False)
                        model_dd.set_sensitive(True)
                        if path:
                            wmodel.set_text(path)
                            model_msg.set_text(T("L_SCN_SET_TR_DL_DONE", name))
                        else:
                            model_msg.set_text(T("L_SCN_SET_TR_DL_FAILED", error) if error
                                               else T("L_SCN_SET_TR_DL_CANCELLED"))
                        refresh_models()
                    GLib.idle_add(lambda: show() and False)
                download_model(f, progress, finished, stop)
            install.connect("clicked", start_download)
            cancel_dl.connect("clicked", lambda *_: self.downloading and self.downloading.set())

            def delete_model(*_):
                name, f, mb = WHISPER_MODELS[model_dd.get_selected()]
                path = os.path.join(MODELS_DIR, f)

                def do():
                    try:
                        os.remove(path)
                    except OSError:
                        pass
                    if wmodel.get_text() == path:
                        wmodel.set_text("")
                    refresh_models()
                self.confirm(self.win, T("L_SCN_SET_TR_DELETE_CONFIRM", name, size_text(mb)),
                             T("L_SCN_SET_TR_DELETE"), do)
            remove.connect("clicked", delete_model)

            whisper_rows = [line(T("L_SCN_SET_TR_BIN"), wbin), hint(""),
                            line(T("L_SCN_SET_TR_MODEL"), model_line), line("", progress_box),
                            line(T("L_SCN_SET_TR_FILE"), wmodel, choose),
                            hint(T("L_SCN_SET_TR_MODEL_HINT", MODELS_DIR))]
            whisper_rows += [grid.get_child_at(0, row[0] - k) for k in (6, 4, 2)] + [choose]
            bin_hint, model_msg = whisper_rows[1], whisper_rows[5]
            wmodel.connect("changed", lambda w: self.save_tr(whisper_model=w.get_text().strip() or None))
            bin_changed()
            model_changed()
            # OpenAI-compatible API
            presets = [p[0] for p in API_PRESETS]
            pnames = {"custom": T("L_SCN_SET_TR_P_CUSTOM"), "ollama": "Ollama", "openai": "OpenAI",
                      "scaleway": "Scaleway Generative APIs", "mistral": "Mistral AI", "groq": "Groq"}
            preset = dropdown([pnames[p] for p in presets],
                              presets.index(tc.get("api_preset")) if tc.get("api_preset") in presets else 0)
            url = Gtk.Entry(text=tc.get("api_url") or "", hexpand=True, placeholder_text="http://localhost:8000/v1")
            model = Gtk.Entry(text=tc.get("api_model") or "", hexpand=True, placeholder_text="whisper-large-v3")
            key = Gtk.PasswordEntry(show_peek_icon=True, hexpand=True)
            key.set_text(tc.get("api_key") or "")
            url.connect("changed", lambda w: self.save_tr(api_url=w.get_text().strip()))
            model.connect("changed", lambda w: self.save_tr(api_model=w.get_text().strip()))
            key.connect("changed", lambda w: self.save_tr(api_key=w.get_text().strip() or None))

            def preset_changed(*_):
                name, u, m = API_PRESETS[preset.get_selected()]
                self.save_tr(api_preset=name)
                if u:
                    url.set_text(u)
                    model.set_text(m)
            preset.connect("notify::selected", preset_changed)
            api_rows = [line(T("L_SCN_SET_TR_PRESET"), preset), line(T("L_SCN_SET_TR_URL"), url),
                        line(T("L_SCN_SET_TR_APIMODEL"), model), line(T("L_SCN_SET_TR_KEY"), key),
                        hint(T("L_SCN_SET_TR_KEY_HINT", SETTINGS)), hint(T("L_SCN_SET_TR_API_HINT"))]
            api_rows += [grid.get_child_at(0, row[0] - k) for k in (3, 4, 5, 6)]
            # test, everything
            tools = Gtk.Box(spacing=8)
            test = icon_button("media-playback-start-symbolic", T("L_SCN_SET_TR_TEST"))
            queue = icon_button("view-list-symbolic", T("L_SCN_SET_TR_ALL"))
            tools.append(test)
            tools.append(queue)
            line("", tools)
            result = hint("")
            test.connect("clicked", lambda *_: self.test_transcription(result))
            queue.connect("clicked", lambda *_: self.transcribe_all(result))

            def engine_changed(*_):
                e = engines[engine.get_selected()]
                self.save_tr(engine=e)
                for w in whisper_rows:
                    if w:
                        w.set_visible(e == "whisper" and (w is not progress_box or self.downloading is not None))
                if e == "whisper":
                    model_changed()
                for w in api_rows:
                    if w:
                        w.set_visible(e == "api")
                for w in (auto, tr_lang, tools, grid.get_child_at(0, grid.query_child(tr_lang)[1])):
                    if w:
                        w.set_visible(e != "off")
                self.refresh_lists()
            engine.connect("notify::selected", engine_changed)
            engine_changed()
            return self.scroll_column(page)

        def choose_file(self, entry):
            """A file chooser for the whisper model (Gtk.FileDialog on GTK >= 4.10)."""
            if not hasattr(Gtk, "FileDialog"):
                return
            dialog = Gtk.FileDialog(title=T("L_SCN_SET_TR_MODEL"))

            def done(d, res):
                try:
                    f = d.open_finish(res)
                except GLib.Error:
                    return
                if f and f.get_path():
                    entry.set_text(f.get_path())
            dialog.open(self.win, None, done)

        def test_transcription(self, result):
            rows = self.store.q("SELECT recording FROM detections WHERE recording IS NOT NULL ORDER BY last_seen "
                                "DESC LIMIT 20")
            path = next((r[0] for r in rows if os.path.exists(r[0])), None)
            if not path:
                result.set_text(T("L_SCN_SET_TR_TEST_NONE"))
                return
            result.set_text(T("L_SCN_SET_TR_TESTING", os.path.basename(path)))

            def work():
                try:
                    text, lang, engine = transcribe(path, self.tr_conf().get("language"), dict(self.tr_conf()))
                    msg = T("L_SCN_SET_TR_TEST_OK", LANG_LABELS.get(lang, lang or "?"), engine,
                            clean_transcript(text) or T("L_SCN_TR_EMPTY"))
                except RuntimeError as e:
                    msg = T("L_SCN_TR_FAILED", e)
                GLib.idle_add(lambda: result.set_text(msg) and False)
            threading.Thread(target=work, daemon=True).start()

        def transcribe_all(self, result):
            rows = self.store.q("SELECT d.id FROM detections d LEFT JOIN transcripts t ON t.detection_id = d.id "
                                "WHERE d.recording IS NOT NULL AND t.detection_id IS NULL")
            for (did,) in rows:
                self.store.request_transcript(did, self.tr_conf().get("language"))
            if self.transcriber:
                self.transcriber.wake.set()
            result.set_text(P("L_SCN_SET_TR_ALL_DONE", len(rows), len(rows)))
            self.refresh_lists()

        def restart(self):
            """Starts the app again (language, region): the scan ends first."""
            for sc in self.scanners:
                sc.stop()
            for sc in self.scanners:
                sc.join(3)
            if self.state is not None and not self.running():
                self.store.end_scan(self.state.scan_id, self.state.passes, self.state.done)
            self.stop_clip()
            # the name it was started with (sdrscanner for the desktops' menus: their pkill looks for it)
            os.execv(sys.executable, [sys.executable, os.path.abspath(ARGV[0])] + ARGV[1:])

        # Spectrum of the current window --------------------------------------------------------------
        def draw_spectrum(self, card, area, cr, w, h):
            fg = fg_color(area)
            accent = self.accent
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.06)
            cr.rectangle(0, 0, w, h)
            cr.fill()
            if not card.spectrum or card.spectrum[0] is None:
                return
            spec, lo, hi = card.spectrum
            freqs, mean, peak = spec["freqs"], spec["mean"], spec["peak"]
            top = max(30.0, float(peak.max()) + 3)
            x = lambda f: (f - lo) / (hi - lo) * w
            y = lambda v: h - 14 - max(0.0, v + 3) / (top + 3) * (h - 24)
            # threshold
            thr = self.threshold.get_value()
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.25)
            cr.set_dash([4, 4])
            cr.move_to(0, y(thr))
            cr.line_to(w, y(thr))
            cr.stroke()
            cr.set_dash([])
            for data, alpha, width in ((peak, 0.35, 1.0), (mean, 1.0, 1.5)):
                cr.set_source_rgba(*accent, alpha)
                cr.set_line_width(width)
                for i, (f, v) in enumerate(zip(freqs, data)):
                    (cr.move_to if i == 0 else cr.line_to)(x(f), y(v))
                cr.stroke()
            cr.set_font_size(11)
            for s in card.signals:
                px = x(s["freq"])
                if s["voice"]:
                    cr.set_source_rgba(*accent, 1)
                    text = T("L_SCN_SPEC_VOICE", s["freq"] / 1e6)
                else:
                    cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.5)
                    text = T("L_SCN_SPEC_CONTINUOUS" if s["continuous"] else "L_SCN_SPEC_PARASITE", s["freq"] / 1e6)
                if s.get("station"):
                    cr.set_source_rgba(*accent, 1)
                    text = "%.1f FM" % (s["freq"] / 1e6)
                elif s.get("candidate"):
                    cr.set_source_rgba(*accent, 0.4 if s["quiet"] else 0.9)
                    text = T("L_SCN_SPEC_BANNED" if s.get("banned") else "L_SCN_SPEC_MUTED" if s["quiet"]
                             else "L_SCN_SPEC_TODO", s["freq"] / 1e6)
                cr.move_to(px, 10)
                cr.line_to(px, h - 14)
                cr.set_line_width(1)
                cr.stroke()
                cr.move_to(min(px + 3, w - 110), 12)
                cr.show_text(text)
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.7)
            for k in range(5):
                f = lo + (hi - lo) * k / 4
                cr.move_to(min(max(0, x(f) - 22), w - 50), h - 2)
                cr.show_text("%.3f" % (f / 1e6))

        def do_shutdown(self):
            self.stop_clip()
            if self.transcriber:
                self.transcriber.stopped = True
                self.transcriber.wake.set()
            if self.running():
                for sc in self.scanners:
                    sc.stop()
                for sc in self.scanners:
                    sc.join(3)
            elif self.state is not None:
                self.store.end_scan(self.state.scan_id, self.state.passes, self.state.done)
            Gtk.Application.do_shutdown(self)

