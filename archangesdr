class Store:
    def __init__(self, path=DB_PATH):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        self.path = path
        self.lock = threading.Lock()
        self.db = sqlite3.connect(path, check_same_thread=False)
        self.db.executescript("""
            CREATE TABLE IF NOT EXISTS scans (id INTEGER PRIMARY KEY, started REAL, ended REAL,
                bands TEXT, passes INTEGER DEFAULT 0, windows INTEGER DEFAULT 0, error TEXT);
            CREATE TABLE IF NOT EXISTS detections (id INTEGER PRIMARY KEY, scan_id INTEGER, freq REAL,
                mode TEXT, label TEXT, first_seen REAL, last_seen REAL, hits INTEGER, snr REAL, score REAL);
            CREATE INDEX IF NOT EXISTS det_scan ON detections(scan_id);
            CREATE TABLE IF NOT EXISTS freq_rules (key INTEGER PRIMARY KEY, freq REAL, label TEXT, mode TEXT,
                parasite INTEGER DEFAULT 0, banned REAL, whitelisted REAL, last_seen REAL, reason TEXT, audio TEXT);
        """)
        cols = {r[1] for r in self.db.execute("PRAGMA table_info(detections)")}
        for col, decl in (("kind", "TEXT DEFAULT 'voice'"), ("reason", "TEXT"), ("audio", "TEXT"),
                          ("params", "TEXT"), ("recording", "TEXT"), ("rec_s", "REAL"), ("device", "TEXT")):
            if col not in cols:
                self.db.execute("ALTER TABLE detections ADD COLUMN %s %s" % (col, decl))
        # Scan interrupted abruptly (machine switched off...): close it at its last detection
        self.db.execute("UPDATE scans SET ended = COALESCE((SELECT MAX(last_seen) FROM detections "
                        "WHERE scan_id = scans.id), started) WHERE ended IS NULL")
        # Transcripts: one per detection (of its recording, else of its capture), a queue of pending ones,
        # and a full-text index (FTS5 is in the SQLite of every distribution checked; LIKE otherwise)
        self.db.execute("CREATE TABLE IF NOT EXISTS transcripts (detection_id INTEGER PRIMARY KEY, status TEXT, "
                        "lang_request TEXT, text TEXT, language TEXT, engine TEXT, error TEXT, requested REAL, "
                        "done REAL)")
        self.db.execute("UPDATE transcripts SET status = 'pending' WHERE status = 'running'")   # killed meanwhile
        try:
            self.db.execute("CREATE VIRTUAL TABLE IF NOT EXISTS transcripts_fts USING fts5(text, "
                            "tokenize = 'unicode61 remove_diacritics 2')")
            self.fts = True
        except sqlite3.OperationalError:
            self.fts = False
        self.db.commit()
        self.rules = FreqRules(self)

    def q(self, sql, args=(), commit=False):
        with self.lock:
            cur = self.db.execute(sql, args)
            if commit:
                self.db.commit()
            return cur.fetchall() if not commit else cur.lastrowid

    def start_scan(self, bands):
        return self.q("INSERT INTO scans (started, bands) VALUES (?, ?)",
                      (time.time(), " · ".join(b.label for b in bands)), True)

    def end_scan(self, scan_id, passes, windows, error=None):
        self.q("UPDATE scans SET ended = ?, passes = ?, windows = ?, error = ? WHERE id = ?",
               (time.time(), passes, windows, error, scan_id), True)

    def progress(self, scan_id, passes, windows):
        self.q("UPDATE scans SET passes = ?, windows = ? WHERE id = ?", (passes, windows, scan_id), True)

    def hit(self, scan_id, sig, band, now, device=None):
        """Signal kept: speech (episode extended as long as it is heard within 2 min) or interference (one
        row per frequency and per scan), per receiver (the statistics compare them). Returns (id, new_row)."""
        kind = "voice" if sig["voice"] else "station" if sig.get("station") else "parasite"
        since = now - ACTIVE_HOLD_S if sig["voice"] else 0      # stations and interference: one row per scan
        rows = self.q("SELECT id, freq, hits FROM detections WHERE scan_id = ? AND kind = ? AND last_seen > ? "
                      "AND ABS(freq - ?) < ? AND COALESCE(device, '') = ? ORDER BY last_seen DESC LIMIT 1",
                      (scan_id, kind, since, sig["freq"], MERGE_HZ, device or ""))
        if rows:
            did, freq, hits = rows[0]
            # refined frequency: average weighted by the number of occurrences
            freq = (freq * hits + sig["freq"]) / (hits + 1)
            self.q("UPDATE detections SET last_seen = ?, hits = hits + 1, freq = ?, snr = MAX(snr, ?), "
                   "score = MAX(score, ?), reason = ? WHERE id = ?",
                   (now, freq, sig["snr"], sig["score"], sig.get("reason"), did), True)
            return did, False
        # params: settings and measurements of the capture that created the row (the one of the audio clip)
        did = self.q("INSERT INTO detections (scan_id, freq, mode, label, first_seen, last_seen, hits, snr, score, "
                     "kind, reason, params, device) VALUES (?, ?, ?, ?, ?, ?, 1, ?, ?, ?, ?, ?, ?)",
                     (scan_id, sig["freq"], sig["mode"], band.label, now, now, sig["snr"], sig["score"], kind,
                      sig.get("reason"), json.dumps(sig.get("params")), device), True)
        return did, True

    def save_clip(self, did, audio, rate=2 * AUDIO_HALF_BW):
        """Writes the capture of the detection did; returns its path."""
        os.makedirs(CLIPS_DIR, exist_ok=True)
        path = os.path.join(CLIPS_DIR, "%d.wav" % did)
        with wave.open(path, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(rate)
            w.writeframes((np.clip(audio, -1, 1) * 32767).astype("<i2").tobytes())
        self.q("UPDATE detections SET audio = ? WHERE id = ?", (path, did), True)
        return path

    def save_recording(self, did, path, seconds):
        self.q("UPDATE detections SET recording = ?, rec_s = ? WHERE id = ?", (path, seconds, did), True)

    def request_transcript(self, did, lang=None):
        """Queues the transcription of detection did (lang: None = detected)."""
        self.q("INSERT INTO transcripts (detection_id, status, lang_request, requested) VALUES (?, 'pending', ?, ?) "
               "ON CONFLICT(detection_id) DO UPDATE SET status = 'pending', lang_request = excluded.lang_request, "
               "requested = excluded.requested, error = NULL", (did, lang, time.time()), True)

    def next_transcript(self):
        """(detection id, language asked, audio file) of the oldest pending transcription, marked running."""
        with self.lock:
            row = self.db.execute("SELECT t.detection_id, t.lang_request, COALESCE(d.recording, d.audio) FROM "
                                  "transcripts t JOIN detections d ON d.id = t.detection_id WHERE t.status = "
                                  "'pending' ORDER BY t.requested LIMIT 1").fetchone()
            if row:
                self.db.execute("UPDATE transcripts SET status = 'running' WHERE detection_id = ?", (row[0],))
                self.db.commit()
            return row

    def save_transcript(self, did, status, text=None, language=None, engine=None, error=None):
        self.q("UPDATE transcripts SET status = ?, text = ?, language = ?, engine = ?, error = ?, done = ? "
               "WHERE detection_id = ?", (status, text, language, engine, error, time.time(), did), True)
        if self.fts:
            self.q("DELETE FROM transcripts_fts WHERE rowid = ?", (did,), True)
            if text:
                self.q("INSERT INTO transcripts_fts (rowid, text) VALUES (?, ?)", (did, text), True)

    def search_transcripts(self, words):
        """Detection ids whose transcript has every word (prefixes: "avia" finds "aviation")."""
        words = [w for w in re.findall(r"\w+", words) if w]
        if not words:
            return None
        if self.fts:
            query = " ".join('"%s"*' % w for w in words)
            return {r[0] for r in self.q("SELECT rowid FROM transcripts_fts WHERE transcripts_fts MATCH ?", (query,))}
        where = " AND ".join("text LIKE ?" for _ in words)
        return {r[0] for r in self.q("SELECT detection_id FROM transcripts WHERE " + where,
                                     ["%%%s%%" % w for w in words])}


class FreqRules:
    """What is decided about a frequency, from one scan to the next (6.25 kHz key, ±1 key matches):
    banned after BAN_PARASITE listens in a row without speech (the survey never listens to it again),
    whitelisted by the user (never banned nor muted, captured as soon as it is above the threshold)."""

    def __init__(self, store):
        self.store = store
        self.lock = threading.Lock()
        self.rows = {k: {"parasite": p or 0, "banned": b, "whitelisted": w}
                     for k, p, b, w in store.q("SELECT key, parasite, banned, whitelisted FROM freq_rules")}

    @staticmethod
    def key(freq):
        return int(round(freq / 6250))

    def _near(self, freq):
        k = self.key(freq)
        return next((j for j in (k, k - 1, k + 1) if j in self.rows), k)

    def _is(self, freq, field):
        with self.lock:
            return bool(self.rows.get(self._near(freq), {}).get(field))

    def banned(self, freq):
        return self._is(freq, "banned")

    def whitelisted(self, freq):
        return self._is(freq, "whitelisted")

    def _save(self, k, freq, band, row, reason=None, audio=None):
        self.store.q("INSERT INTO freq_rules (key, freq, label, mode, parasite, banned, whitelisted, last_seen, "
                     "reason, audio) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON CONFLICT(key) DO UPDATE SET "
                     "freq = excluded.freq, label = COALESCE(excluded.label, label), "
                     "mode = COALESCE(excluded.mode, mode), parasite = excluded.parasite, banned = excluded.banned, "
                     "whitelisted = excluded.whitelisted, last_seen = excluded.last_seen, "
                     "reason = COALESCE(excluded.reason, reason), audio = COALESCE(excluded.audio, audio)",
                     (k, freq, band[0] if band else None, band[1] if band else None, row["parasite"], row["banned"],
                      row["whitelisted"], time.time(), reason, audio), True)

    def parasite(self, sig, band, audio=None):
        """A listen without speech at this frequency; True if it bans it."""
        with self.lock:
            k = self._near(sig["freq"])
            row = self.rows.setdefault(k, {"parasite": 0, "banned": None, "whitelisted": None})
            if row["whitelisted"]:
                return False
            row["parasite"] += 1
            ban = row["parasite"] >= BAN_PARASITE and not row["banned"]
            if ban:
                row["banned"] = time.time()
            row = dict(row)
        self._save(k, sig["freq"], (band.label or band.section, sig["mode"]), row, sig.get("reason"), audio)
        return ban

    def voice(self, freq):
        """Speech heard: the count of listens without speech starts again."""
        with self.lock:
            k = self._near(freq)
            row = self.rows.get(k)
            if not row or not row["parasite"] or row["banned"]:
                return
            row["parasite"] = 0
        self.store.q("UPDATE freq_rules SET parasite = 0 WHERE key = ?", (k,), True)

    def set_whitelisted(self, freq, on, label=None, mode=None):
        """Whitelists (and unbans) or removes from the whitelist; the count starts again either way."""
        with self.lock:
            k = self._near(freq)
            row = self.rows.setdefault(k, {"parasite": 0, "banned": None, "whitelisted": None})
            row.update(parasite=0, banned=None, whitelisted=time.time() if on else None)
            row = dict(row)
        self._save(k, freq, (label, mode) if label or mode else None, row)

    def forget(self, freq):
        """Unbans: the frequency is listened to again, its count starts from zero."""
        with self.lock:
            k = self._near(freq)
            self.rows.pop(k, None)
        self.store.q("DELETE FROM freq_rules WHERE key = ?", (k,), True)


class Recording:
    """Long recording of one conversation: starts with the capture that detected the speech, goes on
    while the channel transmits, ends after RECORD_SILENCE_S without a transmission. The pauses are kept,
    the final silence is not. One file per detection: a conversation heard again later (the same
    detection row, within ACTIVE_HOLD_S) is appended to it."""

    RATE = 2 * AUDIO_HALF_BW

    def __init__(self, store, sig, threshold):
        self.store, self.did, self.threshold = store, sig["id"], threshold
        self.freq, self.kind = sig.get("center", sig["freq"]), sig["demod"] or "fm"
        self.peak, self.gain = sig.get("peak", sig["freq"]), sig.get("gain", 1.0)
        self.silent_s, self.live = 0.0, True
        self.pending = 0            # silence not written yet (dropped if nothing follows)
        os.makedirs(RECORDINGS_DIR, exist_ok=True)
        self.path = os.path.join(RECORDINGS_DIR, "%d.wav" % self.did)
        self.part = os.path.join(RECORDINGS_DIR, "%d.part.wav" % self.did)
        self.w = wave.open(self.part, "wb")
        self.w.setnchannels(1)
        self.w.setsampwidth(2)
        self.w.setframerate(self.RATE)
        self.frames = 0
        self.write(np.trim_zeros(sig["audio"], "b"))

    def write(self, audio):
        if self.pending:
            self.w.writeframes(bytes(2 * self.pending))
            self.frames += self.pending
            self.pending = 0
        self.w.writeframes((np.clip(audio, -1, 1) * 32767).astype("<i2").tobytes())
        self.frames += len(audio)

    def feed(self, X, n, tuned, freqs, P, floor):
        """One block: X its FFT (n samples), P its spectrum frame by frame, floor the noise of each frame."""
        on = 10 * np.log10(P[:, np.abs(freqs - self.peak) <= RECORD_CHAN_HZ].mean(axis=1) / floor + 1e-12) \
            > self.threshold
        on = fill_gaps(on, int(HANG_S / FRAME_S))
        df = FS / n
        half = int(AUDIO_HALF_BW / df)
        c = int(round((self.freq - tuned) / df))
        audio = demodulate(np.fft.ifft(np.fft.ifftshift(X[np.arange(c - half, c + half) % n])), self.kind, self.RATE)
        step = int(FRAME_S * self.RATE)
        audio = np.resize(audio, len(on) * step) * self.gain
        for i, active in enumerate(on):
            if active:
                self.silent_s = 0.0
                self.write(audio[i * step:(i + 1) * step])
            else:
                self.silent_s += FRAME_S
                self.pending += step
                if self.silent_s >= RECORD_SILENCE_S:
                    self.live = False
                    break

    @property
    def seconds(self):
        return self.frames / self.RATE

    def close(self):
        self.live = False
        self.w.close()
        if os.path.exists(self.path):     # the same conversation, heard again: appended
            with wave.open(self.path, "rb") as a, wave.open(self.part, "rb") as b:
                old, new = a.readframes(a.getnframes()), b.readframes(b.getnframes())
            tmp = self.path + ".tmp"
            with wave.open(tmp, "wb") as w:
                w.setnchannels(1)
                w.setsampwidth(2)
                w.setframerate(self.RATE)
                w.writeframes(old + bytes(2 * int(REC_GAP_S * self.RATE)) + new)
            os.replace(tmp, self.path)
            os.remove(self.part)
        else:
            os.replace(self.part, self.path)
        with wave.open(self.path, "rb") as w:
            total = w.getnframes() / self.RATE
        self.store.save_recording(self.did, self.path, total)
        if transcription_conf().get("auto", True) and transcription_conf().get("engine", "off") != "off":
            self.store.request_transcript(self.did)
        threading.Thread(target=notify_recording, args=(self.store, self.did), daemon=True).start()
        return total


