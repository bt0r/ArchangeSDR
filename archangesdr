def transcription_conf():
    """{engine: off | whisper | api, auto, whisper_bin, whisper_model, api_preset, api_url, api_model,
    api_key, language (None: detected)}."""
    return load_settings().get("transcription", {})


def whisper_binary(conf=None):
    conf = transcription_conf() if conf is None else conf
    import shutil
    if conf.get("whisper_bin"):
        return conf["whisper_bin"] if os.access(conf["whisper_bin"], os.X_OK) else None
    return next((shutil.which(b) for b in WHISPER_BINARIES if shutil.which(b)), None)


def download_model(filename, progress, finished, stop):
    """Downloads a whisper.cpp model into MODELS_DIR, in a thread: progress(bytes, total) along the way,
    finished(path, None) at the end, finished(None, error) if it fails, finished(None, None) if stop is
    set. Written to <file>.part, renamed when complete."""
    import urllib.error
    import urllib.request

    def run():
        os.makedirs(MODELS_DIR, exist_ok=True)
        path = os.path.join(MODELS_DIR, filename)
        part = path + ".part"
        try:
            with urllib.request.urlopen(MODEL_URL % filename, timeout=30) as r, open(part, "wb") as out:
                total, got = int(r.headers.get("Content-Length") or 0), 0
                while True:
                    if stop.is_set():
                        raise InterruptedError
                    chunk = r.read(1 << 20)
                    if not chunk:
                        break
                    out.write(chunk)
                    got += len(chunk)
                    progress(got, total)
            if (total and got != total) or got < 1_000_000:      # cut short, or an error page
                raise OSError(T("L_SCN_SET_TR_DL_INCOMPLETE"))
            os.replace(part, path)
            finished(path, None)
        except InterruptedError:
            finished(None, None)
        except (OSError, urllib.error.URLError) as e:
            finished(None, str(getattr(e, "reason", e)))
        finally:
            if os.path.exists(part):
                os.remove(part)
    threading.Thread(target=run, daemon=True).start()


def clean_transcript(text):
    """The text, or "" when it is only a known hallucination or one phrase repeated."""
    text = " ".join((text or "").split())
    low = text.lower().strip(" .!?…-")
    if not low or any(h in low and len(low) < len(h) + 12 for h in HALLUCINATIONS):
        return ""
    words = low.split()
    if len(words) >= 8 and len(set(words)) <= 2:
        return ""
    return text


def _transcribe_whisper(path, lang, conf):
    import tempfile
    exe = whisper_binary(conf)
    model = conf.get("whisper_model") or ""
    if not exe:
        raise RuntimeError(T("L_SCN_TR_ERR_NO_WHISPER"))
    if not os.path.isfile(model):
        raise RuntimeError(T("L_SCN_TR_ERR_NO_MODEL", model or "-"))
    with tempfile.TemporaryDirectory() as tmp:
        out = os.path.join(tmp, "t")
        cmd = [exe, "-m", model, "-f", path, "-l", lang or "auto", "-oj", "-of", out, "-np",
               "-t", str(max(1, (os.cpu_count() or 2) - 1))]
        # lowest priority: the scan (and its USB reads) comes first
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=900,
                           preexec_fn=lambda: os.nice(19))
        if p.returncode != 0 or not os.path.isfile(out + ".json"):
            raise RuntimeError(T("L_SCN_TR_ERR_WHISPER", p.returncode,
                                 " ".join(p.stderr.decode(errors="replace").strip().splitlines()[-1:])))
        data = json.load(open(out + ".json", encoding="utf-8", errors="replace"))
    text = " ".join(seg.get("text", "").strip() for seg in data.get("transcription", []))
    found = (data.get("result") or {}).get("language") or lang
    return text, found, "whisper-cli · " + os.path.basename(model)


def _transcribe_api(path, lang, conf):
    import urllib.error
    import urllib.request
    import uuid
    url = (conf.get("api_url") or "").rstrip("/")
    model = conf.get("api_model") or ""
    if not url or not model:
        raise RuntimeError(T("L_SCN_TR_ERR_API_CONF"))

    def post(fmt):
        boundary = uuid.uuid4().hex
        fields = [("model", model), ("response_format", fmt)] + ([("language", lang)] if lang else [])
        body = b"".join(b'--%s\r\nContent-Disposition: form-data; name="%s"\r\n\r\n%s\r\n'
                        % (boundary.encode(), k.encode(), v.encode()) for k, v in fields)
        body += (b'--%s\r\nContent-Disposition: form-data; name="file"; filename="%s"\r\nContent-Type: audio/wav'
                 b'\r\n\r\n' % (boundary.encode(), os.path.basename(path).encode())) + open(path, "rb").read() + \
            b"\r\n--%s--\r\n" % boundary.encode()
        req = urllib.request.Request(url + "/audio/transcriptions", data=body, method="POST",
                                     headers={"Content-Type": "multipart/form-data; boundary=" + boundary})
        if conf.get("api_key"):
            req.add_header("Authorization", "Bearer " + conf["api_key"])
        with urllib.request.urlopen(req, timeout=300) as r:
            return json.loads(r.read().decode("utf-8", "replace"))
    try:
        try:
            data = post("verbose_json")     # gives the detected language
        except urllib.error.HTTPError as e:
            if e.code not in (400, 415, 422):
                raise
            data = post("json")             # servers without verbose_json
    except urllib.error.HTTPError as e:
        detail = e.read().decode("utf-8", "replace")[:200].strip()
        raise RuntimeError(T("L_SCN_TR_ERR_HTTP", e.code, detail))
    except (urllib.error.URLError, OSError) as e:
        raise RuntimeError(T("L_SCN_TR_ERR_NET", getattr(e, "reason", e)))
    found = data.get("language") or lang
    found = LANG_NAMES.get(str(found).lower(), found)
    return data.get("text", ""), found, "%s · %s" % (url.split("//")[-1].split("/")[0], model)


def transcribe(path, lang=None, conf=None):
    """(text, language, engine) of an audio file with the engine of the settings; RuntimeError if it fails."""
    conf = transcription_conf() if conf is None else conf
    engine = conf.get("engine", "off")
    if engine == "whisper":
        return _transcribe_whisper(path, lang, conf)
    if engine == "api":
        return _transcribe_api(path, lang, conf)
    raise RuntimeError(T("L_SCN_TR_ERR_OFF"))


class Transcriber(threading.Thread):
    """Transcribes the queued recordings one at a time, in the background (the engine of the moment's
    settings); on_done(detection id) after each one."""

    def __init__(self, store, on_done=None):
        super().__init__(daemon=True)
        self.store, self.on_done = store, on_done
        self.wake = threading.Event()
        self.stopped = False

    def run(self):
        while not self.stopped:
            job = self.store.next_transcript() if transcription_conf().get("engine", "off") != "off" else None
            if job is None:
                self.wake.wait(5)
                self.wake.clear()
                continue
            did, lang, path = job
            try:
                with wave.open(path, "rb") as w:
                    seconds = w.getnframes() / w.getframerate()
                if seconds < TRANSCRIBE_MIN_S:
                    self.store.save_transcript(did, "empty", error=T("L_SCN_TR_TOO_SHORT"))
                else:
                    text, found, engine = transcribe(path, lang)
                    text = clean_transcript(text)
                    self.store.save_transcript(did, "done" if text else "empty", text or None, found, engine)
            except (RuntimeError, OSError, ValueError, wave.Error, subprocess.SubprocessError) as e:
                self.store.save_transcript(did, "error", error=str(e))
            if self.on_done:
                self.on_done(did)


class ScanState:
    """What the receivers share and what survives a pause: the ranges, the sweep plan (each hop with its
    number of visits and the receiver working on it), the memory of the signals already listened to.

    Several receivers sweep the same plan: each one takes the free hop visited the least, among those
    the fewest receivers can tune (what only it reaches goes first: the HF for a Blog V4), then in the
    sweep order. A hop is worked on by one receiver at a time and the hops do not overlap, so two
    receivers never analyse the same frequency."""

    def __init__(self, bands, dwell=2.5, threshold=8.0, max_passes=0):
        self.bands, self.dwell, self.max_passes = bands, dwell, max_passes
        self.detector = Detector(threshold)
        self.scan_id = None
        self.done = 0
        self.stations = set()     # FM radios already recorded during this scan (100 kHz key)
        self.boosts = {}          # recency boost: 6.25 kHz key → {band, freq, until, due}
        self.lock = threading.RLock()
        self.hops = [{"band": b, "c": c, "lo": lo, "hi": hi, "wide": wide, "visits": 0, "coverers": 0}
                     for b in bands for c, lo, hi, wide in b.hops()]
        self.claims = {}          # hop index → receiver working on it
        self.coverage = {}        # receiver → [(lo, hi)] it tunes
        self.running = set()      # receivers whose thread is alive
        self.errors = []
        self.paused = False

    @property
    def passes(self):
        """Complete passes: every hop visited that many times."""
        return min((h["visits"] for h in self.hops), default=0)

    @staticmethod
    def tuned(h):
        # wide hops: every other visit 50 kHz lower, so the DC spike never hides the same channel (the
        # hop's own interval stays inside the capture either way)
        return h["c"] - 50_000 * (h["visits"] % 2) if h["wide"] else h["c"]

    @staticmethod
    def covers(segs, h):
        lo, hi = min(h["lo"], h["c"]), max(h["hi"], h["c"])
        return any(a <= lo and hi <= b for a, b in segs)

    def register(self, dev, segs):
        with self.lock:
            self.coverage[dev] = segs
            self._count()

    def unregister(self, dev):
        with self.lock:
            self.coverage.pop(dev, None)
            for i in [i for i, d in self.claims.items() if d == dev]:
                del self.claims[i]
            self._count()

    def _count(self):
        for h in self.hops:
            h["coverers"] = sum(self.covers(segs, h) for segs in self.coverage.values())

    def reachable(self, dev):
        """Hops this receiver can tune (whoever is on them now)."""
        segs = self.coverage.get(dev, [])
        return [i for i, h in enumerate(self.hops) if self.covers(segs, h)]

    def pick(self, dev):
        """The next hop for receiver dev, claimed for it; None if none is free for it right now, False if
        it has nothing left to do (nothing it can tune, or max_passes reached)."""
        with self.lock:
            segs = self.coverage.get(dev, [])
            best, left = None, False
            for i, h in enumerate(self.hops):
                if not self.covers(segs, h) or self.max_passes and h["visits"] >= self.max_passes:
                    continue
                left = True
                key = (h["visits"], h["coverers"], i)
                if i not in self.claims and (best is None or key < best):
                    best = key
            if best is None:
                return None if left else False
            self.claims[best[2]] = dev
            return best[2]

    def claim(self, i, dev):
        """Claims hop i (a recency-boost visit) if it is free and dev tunes it."""
        with self.lock:
            if i in self.claims or not self.covers(self.coverage.get(dev, []), self.hops[i]):
                return False
            self.claims[i] = dev
            return True

    def release(self, i, visited):
        with self.lock:
            self.claims.pop(i, None)
            if visited:
                self.hops[i]["visits"] += 1

    def hop_of(self, band, freq):
        return next((i for i, h in enumerate(self.hops) if h["band"] is band and h["lo"] <= freq < h["hi"]), None)

    def estimate(self):
        return len(self.hops) * (SURVEY_S + 0.06)     # + tuning (30 ms dropped) and the FFT


def listen_windows(lo_bound, hi_bound, cands):
    """1 MHz listening windows covering the spotted frequencies, each starting just below the first one,
    inside [lo_bound, hi_bound] (the hop's own interval: another receiver may be on the next one)."""
    out, i = [], 0
    while i < len(cands):
        lo = max(lo_bound, cands[i] - 30_000)
        hi = min(hi_bound, lo + WINDOW)
        group = [f for f in cands[i:] if f < hi - 10_000] or [cands[i]]
        out.append((lo, hi, group))
        i += len(group)
    return out


class Scanner(threading.Thread):
    """One receiver sweeping the shared plan until stop() or pause(): quick survey of a hop, then a
    progressive listen (speech analysis) only where a narrow peak showed up. Callbacks on_start / on_tune
    / on_window / on_hit / on_record / on_end, each called with the receiver id first. After a pause, new
    Scanners on the same ScanState carry on with the hops visited the least.
    device: {"id", "index", "label", "gain" (None: SDR_GAIN), "hf" (None: automatic)}."""

    def __init__(self, state, store, device, callbacks=None):
        super().__init__(daemon=True)
        self.state, self.store, self.device = state, store, device
        self.dev = device["id"]
        self.stop_event = threading.Event()
        self.pausing = False
        self.cb = callbacks or {}
        self.hop_i = 0
        state.detector.rules = store.rules

    @property
    def scan_id(self):
        return self.state.scan_id

    def emit(self, name, *args):
        if name in self.cb:
            self.cb[name](self.dev, *args)

    def tune_event(self, band, lo, hi, phase):
        st = self.state
        self.emit("on_tune", band, lo, hi, self.hop_i, len(st.hops), st.passes, phase)

    def stop(self):
        self.stop_event.set()

    def pause(self):
        self.pausing = True
        self.state.paused = True
        self.stop_event.set()

    def record(self, sdr, band, lo, hi, tuned, signals):
        st = self.state
        now = time.time()
        for sig in signals:
            f = sig.get("features")
            sig["params"] = {
                "freq": round(sig["freq"]), "mode": sig["mode"], "demod": sig["demod"],
                "window": [lo, hi], "tuned": tuned, "rate": FS, "dwell": st.dwell,
                "threshold": st.detector.threshold, "gain": sdr.gain, "device": sdr.name, "device_id": self.dev,
                "direct": sdr.direct, "snr": round(sig["snr"], 1), "occupancy": round(sig["occupancy"], 2),
                "tx_s": round(sig["tx_s"], 1), "width_khz": round(sig["width"] / 1000, 1),
                "score": round(sig["score"], 2), "features": [round(v, 2) for v in f] if f else None}
            did, new = self.store.hit(st.scan_id, sig, band, now, self.dev)
            sig["id"] = did
            # every signal kept has its capture, interference too (to spot a false positive)
            clip = self.store.save_clip(did, sig["audio"]) if new and sig.get("audio") is not None else None
            if not sig["voice"] and not sig.get("station"):
                if self.store.rules.parasite(sig, band, clip):
                    sig["banned"] = True
                    sig["reason"] = T("L_SCN_REASON_BANNED", sig["reason"] or "", BAN_PARASITE)
                    self.store.q("UPDATE detections SET reason = ? WHERE id = ?", (sig["reason"], did), True)
                continue
            if sig["voice"]:
                self.store.rules.voice(sig["freq"])
            self.emit("on_hit", sig, band, new)

    def listen(self, sdr, band, lo, hi, tuned=None, group=None):
        """Listen of a window (and recording of what speaks there); None if paused / stopped meanwhile.
        group: the survey's candidates in the window, which the progressive verdict is about."""
        tuned = lo - DC_GAP if tuned is None else tuned
        self.tune_event(band, lo, hi, "listen")
        sdr.tune(tuned)
        sdr.start_stream()
        try:
            return self._listen(sdr, band, lo, hi, tuned, group)
        finally:
            sdr.stop_stream()

    @staticmethod
    def decided(signals, group, t):
        """Progressive listen: is the verdict already clear after t seconds?"""
        if t >= LISTEN_VOICE_S - 1e-9 and any(s["voice"] for s in signals):
            return True              # speech: the recording takes over
        if not group:
            return False
        near = [s for s in signals if any(abs(s.get("peak", s["freq"]) - f) <= 10_000 for f in group)]
        if any(s["voice"] for s in near):
            return False             # speech, but not confirmed yet
        # gone quiet (pulse, burst), or every candidate is a continuous carrier, wide, or far from speech
        return all(s["continuous"] or s["width"] > MAX_WIDTH_HZ or s["score"] < LISTEN_GIVE_UP for s in near)

    def _listen(self, sdr, band, lo, hi, tuned, group):
        st = self.state
        total, step = int(FS * st.dwell), int(FS * LISTEN_STEP_S)
        blocks, got = [], 0
        while True:
            iq = sdr.read(min(step, total - got), self.stop_event)
            if iq is None:
                return None
            blocks.append(iq)
            got += len(iq)
            t = got / FS
            if got < total and (band.mode == "WFM" or t < LISTEN_MIN_S - 1e-9):
                continue             # FM radio: the whole dwell (the clip of the stations)
            spectrum, signals = st.detector.analyze(np.concatenate(blocks), tuned, lo, hi, band)
            if got >= total or band.mode != "WFM" and self.decided(signals, group, t):
                break
        signals = [s for s in signals if not st.detector.banned(s["freq"])]    # banned: never again
        with st.lock:
            st.detector.track(signals)
            st.done += 1
        self.record(sdr, band, lo, hi, tuned, signals)
        with st.lock:
            st.detector.after_listen(signals, st.passes)
        self.emit("on_window", band, lo, hi, spectrum, signals, len(st.detector.ignored))
        voices = [s for s in signals if s["voice"] and s.get("audio") is not None and s.get("id")]
        if voices and not self.follow(sdr, band, lo, hi, tuned, voices):
            return None
        return signals

    def follow(self, sdr, band, lo, hi, tuned, voices):
        """Stays on the window and records the conversations just heard there, until each one has been
        silent for RECORD_SILENCE_S (RECORD_MAX_S at most). False if paused / stopped meanwhile (what was
        recorded is kept)."""
        st = self.state
        recs = [Recording(self.store, sig, st.detector.threshold) for sig in voices]
        n, frame = int(FS * RECORD_CHUNK_S), int(FS * FRAME_S)
        segs = frame // NFFT
        win = np.hanning(NFFT).astype(np.float32)
        freqs = tuned + (np.arange(NFFT) - NFFT // 2) * FS / NFFT
        keep = (freqs >= lo) & (freqs <= hi)
        start, stopped = time.time(), False
        self.tune_event(band, lo, hi, "record")
        try:
            while any(r.live for r in recs) and time.time() - start < RECORD_MAX_S:
                iq = sdr.read(n, self.stop_event)
                if iq is None:
                    stopped = True
                    break
                nf = len(iq) // frame
                x = iq[:nf * frame].reshape(nf, frame)[:, :segs * NFFT].reshape(nf, segs, NFFT)
                P = np.fft.fftshift((np.abs(np.fft.fft(x * win, axis=2)) ** 2).mean(axis=1), axes=1)
                floor = np.median(P[:, keep], axis=1)
                X = np.fft.fft(iq)
                for r in recs:
                    if r.live:
                        r.feed(X, len(iq), tuned, freqs, P, floor)
                S = 10 * np.log10(P[:, keep] / floor[:, None] + 1e-12)
                self.emit("on_record", band, lo, hi, Detector._display(freqs[keep], S, np.ones(nf, bool)),
                          voices, [(r.freq, r.seconds, r.silent_s, r.live) for r in recs], False)
        finally:
            done = [(r.freq, r.close(), 0.0, False) for r in recs]
            self.emit("on_record", band, lo, hi, None, voices, done, True)
            now = time.time()
            with st.lock:
                for sig in voices:   # the reply often follows within seconds: come back to it
                    st.boosts[FreqRules.key(sig["freq"])] = {"band": band, "freq": sig["freq"],
                                                             "until": now + RECENCY_S, "due": now + RECENCY_EVERY_S}
        return not stopped

    def revisit(self, sdr):
        """Recency boost: the windows of the recent conversations, checked again between two hops (a short
        survey, a listen if the frequency is back) by a receiver that tunes them and when no other one is
        on that hop. False if paused / stopped meanwhile."""
        st = self.state
        with st.lock:
            now = time.time()
            for key in [k for k, b in st.boosts.items() if now >= b["until"]]:
                del st.boosts[key]
            due = [b for b in st.boosts.values() if now >= b["due"]]
        for b in due:
            i = st.hop_of(b["band"], b["freq"])
            if i is None or not st.claim(i, self.dev):
                continue
            b["due"] = time.time() + RECENCY_EVERY_S
            self.hop_i = i
            try:
                h = st.hops[i]
                for wlo, whi, _ in listen_windows(h["lo"], h["hi"], [b["freq"]]):
                    tuned = wlo - DC_GAP
                    self.tune_event(h["band"], wlo, whi, "revisit")
                    sdr.tune(tuned)
                    iq = sdr.read(int(FS * SURVEY_S), self.stop_event)
                    if iq is None:
                        return False
                    spectrum, cands = st.detector.survey(iq, tuned, wlo, whi)
                    todo = [f for f, _ in cands if abs(f - b["freq"]) <= 10_000 and not st.detector.banned(f)]
                    if todo and self.listen(sdr, h["band"], wlo, whi, group=todo) is None:
                        return False
            finally:
                st.release(i, False)
        return True

    def hop(self, sdr, h):
        """Survey of hop h, then the listens; False if paused / stopped meanwhile."""
        st, det = self.state, self.state.detector
        band, lo, hi, tuned = h["band"], h["lo"], h["hi"], st.tuned(h)
        self.tune_event(band, lo, hi, "survey")
        sdr.tune(tuned)
        iq = sdr.read(int(FS * SURVEY_S), self.stop_event)
        if iq is None:
            return False
        if band.mode == "WFM":
            # FM radio: the stations show up at the survey; a listen only if there are new ones for this
            # scan (the audio clip)
            spectrum, found = det.analyze(iq, tuned, lo, hi, band)
            self.emit("on_window", band, lo, hi, spectrum, found, 0)
            with st.lock:
                new = any(int(round(x["freq"] / 1e5)) not in st.stations for x in found)
            if new:
                if self.listen(sdr, band, lo, hi, tuned) is None:
                    return False
                with st.lock:
                    st.stations.update(int(round(x["freq"] / 1e5)) for x in found)
            else:
                self.record(sdr, band, lo, hi, tuned, found)
            return True
        spectrum, cands = det.survey(iq, tuned, lo, hi)
        passes = h["visits"]
        todo = [f for f, _ in cands if det.whitelisted(f) or not (det.banned(f) or det.is_quiet(f, passes))]
        marks = [{"freq": f, "snr": d, "voice": False, "continuous": False, "candidate": True,
                  "quiet": f not in todo, "banned": det.banned(f)} for f, d in cands]
        self.emit("on_window", band, lo, hi, spectrum, marks, len(det.ignored))
        for wlo, whi, group in listen_windows(lo, hi, todo):
            if self.listen(sdr, band, wlo, whi, group=group) is None:
                return False
        return True

    def run(self):
        st = self.state
        conf = read_conf()
        with st.lock:
            if st.scan_id is None:
                st.scan_id = self.store.start_scan(st.bands)
            st.running.add(self.dev)
        error = None
        sdr = None
        try:
            gain = self.device.get("gain")
            sdr = RtlSdr(self.device["index"], float(gain if gain is not None else conf["SDR_GAIN"] or 40),
                         conf["SDR_ASYNC"] != "0", self.device.get("hf"))
            update_device_conf(self.dev, name=sdr.name, tuner=sdr.tuner)
            st.register(self.dev, sdr.coverage())
            if not st.reachable(self.dev):
                raise RuntimeError(T("L_SCN_DEV_NOTHING", coverage_text(sdr.tuner, sdr.hf)))
            self.emit("on_start", st.scan_id, sdr.name)
            last_passes = st.passes
            while not self.stop_event.is_set():
                if st.boosts and not self.revisit(sdr):
                    break
                i = st.pick(self.dev)
                if i is False:
                    break             # max_passes reached for what this receiver tunes
                if i is None:
                    self.stop_event.wait(0.05)     # the other receivers hold what is left for now
                    continue
                self.hop_i = i
                done = False
                try:
                    done = self.hop(sdr, st.hops[i])
                finally:
                    st.release(i, done)
                if not done:
                    break
                if st.passes != last_passes:
                    last_passes = st.passes
                    self.store.progress(st.scan_id, st.passes, st.done)
        except Exception as e:   # dongle missing, busy, unplugged...
            error = str(e)
        finally:
            if sdr:
                sdr.close()
            st.unregister(self.dev)
            with st.lock:
                st.running.discard(self.dev)
                if error:
                    st.errors.append("%s: %s" % (self.device.get("label") or self.dev, error))
                last = not st.running
            paused = self.pausing and error is None
            if last:                  # the last receiver out closes the scan (or keeps it for a resume)
                if st.paused:
                    self.store.progress(st.scan_id, st.passes, st.done)
                else:
                    self.store.end_scan(st.scan_id, st.passes, st.done, "; ".join(st.errors) or None)
            self.emit("on_end", error, paused)


# --- GQRX ----------------------------------------------------------------------------------------

GQRX_MODES = {"AM": ("AM", "AM", -5000, 5000), "NFM": ("Narrow FM", "FM", -5000, 5000),
              "FM": ("Narrow FM", "FM", -5000, 5000), "USB": ("USB", "USB", 100, 2800),
              "LSB": ("LSB", "LSB", -2800, -100), "WFM": ("WFM (stereo)", "WFM_ST", -80000, 80000)}


def ini_set(text, section, key, value):
    """Replaces (or adds) key=value in [section] of a Qt INI file, without touching the rest."""
    lines = text.splitlines()
    start = next((i for i, l in enumerate(lines) if l.strip() == "[%s]" % section), None)
    if start is None:
        return text.rstrip("\n") + "\n\n[%s]\n%s=%s\n" % (section, key, value)
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("[")), len(lines))
    for i in range(start + 1, end):
        if lines[i].split("=", 1)[0] == key:
            lines[i] = "%s=%s" % (key, value)
            return "\n".join(lines) + "\n"
    lines.insert(end if end == len(lines) or lines[end - 1].strip() else end - 1, "%s=%s" % (key, value))
    return "\n".join(lines) + "\n"


def open_gqrx(freq, mode, device=None):
    """GQRX tuned to freq (mode of the range), DSP started, on the dongle of that index (None: the one
    GQRX already uses, else SDR_DEVICE). The dongle must be free."""
    conf = read_conf()
    gdir = os.path.expanduser("~/.config/gqrx")
    os.makedirs(gdir, exist_ok=True)
    try:
        text = open(os.path.join(gdir, "default.conf")).read()
    except OSError:
        text = "[General]\nconfigversion=4\n"
    label, remote_mode, low, high = GQRX_MODES.get(mode, GQRX_MODES["NFM"])
    offset = 200_000   # the channel 200 kHz from the centre, far from the DC spike
    if device is not None or "device=" not in text:
        text = ini_set(text, "input", "device", '"rtl=%s"' % (device if device is not None else conf["SDR_DEVICE"]))
    for section, key, value in (("General", "crashed", "false"), ("input", "frequency", int(freq - offset)),
                                ("receiver", "offset", offset), ("receiver", "demod", label),
                                ("receiver", "filter_low_cut", low), ("receiver", "filter_high_cut", high),
                                ("remote_control", "enabled", "true"),
                                ("remote_control", "allowed_hosts", "127.0.0.1")):
        text = ini_set(text, section, key, value)
    path = os.path.join(gdir, "archangesdr.conf")
    open(path, "w").write(text)

    run_quiet(["pkill", "-x", "gqrx"])
    for _ in range(25):
        if run_quiet(["pgrep", "-x", "gqrx"]):
            break
        time.sleep(0.2)
    if not launch(["gqrx", "-c", path], conf["RADIO_WS"]):
        return False

    # The file sets the frequency and the filter; the remote control (port 7356) sets the mode and
    # starts the DSP, which the configuration cannot do.
    def remote():
        for _ in range(60):
            time.sleep(0.5)
            try:
                with socket.create_connection(("127.0.0.1", 7356), timeout=2) as s:
                    for cmd in ("F %d" % int(freq), "M %s %d" % (remote_mode, high - low), "U DSP 1"):
                        s.sendall((cmd + "\n").encode())
                        s.recv(64)
                return
            except OSError:
                continue
    threading.Thread(target=remote, daemon=True).start()
    return True


def run_quiet(argv):
    """Runs a helper command (pkill, pgrep...); its return code, 127 if it is not installed (procps is
    missing from some minimal installs and containers)."""
    try:
        return subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode
    except FileNotFoundError:
        return 127


def launch(argv, workspace=""):
    """Starts a program detached. Under Hyprland with RADIO_WS set, on that workspace (archSDR); under
    i3, the desktop's own rules place it (uBonsole assigns gqrx to the radio workspace)."""
    import shutil
    if not shutil.which(argv[0]):
        return False
    if workspace and os.environ.get("HYPRLAND_INSTANCE_SIGNATURE") and shutil.which("hyprctl"):
        cmd = " ".join("'%s'" % a.replace("'", "'\\''") for a in argv)
        subprocess.run(["hyprctl", "dispatch", 'hl.dsp.exec_cmd([==[%s]==], {workspace="%s"})' % (cmd, workspace)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        subprocess.Popen(argv, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


def notify(title, body):
    try:
        subprocess.Popen(["notify-send", "-a", T("L_SCN_NOTIFY_APP"), "-i", "network-wireless", title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except FileNotFoundError:   # no libnotify: the in-app banner and the active list are enough
        pass


