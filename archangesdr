def rtl_lib():
    """librtlsdr, loaded once (OSError if it is not installed)."""
    if _LIB:
        return _LIB[0]
    lib = ctypes.CDLL(ctypes.util.find_library("rtlsdr") or "librtlsdr.so.0")
    lib.rtlsdr_get_device_count.restype = ctypes.c_uint32
    lib.rtlsdr_get_index_by_serial.argtypes = [ctypes.c_char_p]
    lib.rtlsdr_open.argtypes = [ctypes.POINTER(ctypes.c_void_p), ctypes.c_uint32]
    for fn in ("close", "reset_buffer"):
        getattr(lib, "rtlsdr_" + fn).argtypes = [ctypes.c_void_p]
    for fn in ("set_sample_rate", "set_center_freq"):
        getattr(lib, "rtlsdr_" + fn).argtypes = [ctypes.c_void_p, ctypes.c_uint32]
    for fn in ("set_tuner_gain_mode", "set_tuner_gain", "set_agc_mode", "set_direct_sampling"):
        getattr(lib, "rtlsdr_" + fn).argtypes = [ctypes.c_void_p, ctypes.c_int]
    lib.rtlsdr_get_tuner_type.argtypes = [ctypes.c_void_p]
    lib.rtlsdr_get_tuner_gains.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
    lib.rtlsdr_read_sync.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_int, ctypes.POINTER(ctypes.c_int)]
    lib.rtlsdr_get_device_usb_strings.argtypes = [ctypes.c_uint32] + [ctypes.c_char_p] * 3
    lib.rtlsdr_read_async.argtypes = [ctypes.c_void_p, ASYNC_CB, ctypes.c_void_p, ctypes.c_uint32, ctypes.c_uint32]
    lib.rtlsdr_cancel_async.argtypes = [ctypes.c_void_p]
    lib.rtlsdr_get_device_name.restype = ctypes.c_char_p
    lib.rtlsdr_get_device_name.argtypes = [ctypes.c_uint32]
    _LIB.append(lib)
    return lib


def usb_strings(lib, index):
    strings = [ctypes.create_string_buffer(256) for _ in range(3)]
    lib.rtlsdr_get_device_usb_strings(index, *strings)
    return [x.value.decode(errors="replace").strip() for x in strings]


def list_devices():
    """The RTL-SDR dongles plugged in, without opening them: index, USB strings, id. The id is the
    serial number, or serial#index when two dongles share it (many leave the factory with 00000001:
    rtl_eeprom -s gives each its own)."""
    try:
        lib = rtl_lib()
    except OSError:
        return []
    out = []
    for i in range(lib.rtlsdr_get_device_count()):
        maker, product, serial = usb_strings(lib, i)
        out.append({"index": i, "maker": maker, "product": product, "serial": serial,
                    "chip": (lib.rtlsdr_get_device_name(i) or b"").decode(errors="replace")})
    serials = [d["serial"] for d in out]
    for d in out:
        d["id"] = d["serial"] if d["serial"] and serials.count(d["serial"]) == 1 else \
            "%s#%d" % (d["serial"] or "rtl", d["index"])
    return out


_DEVICES_LOCK = threading.Lock()


def load_device_conf():
    try:
        conf = json.load(open(DEVICES, encoding="utf-8"))
        return conf if isinstance(conf, dict) else {}
    except (OSError, ValueError):
        return {}


def update_device_conf(dev_id, **fields):
    """Sets fields of a receiver in the receivers file (from the window or a scan thread)."""
    with _DEVICES_LOCK:
        conf = load_device_conf()
        conf.setdefault(dev_id, {}).update(fields)
        os.makedirs(os.path.dirname(DEVICES), exist_ok=True)
        tmp = DEVICES + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(conf, f, ensure_ascii=False, indent=1)
        os.replace(tmp, DEVICES)


def receivers():
    """The dongles plugged in, with their settings: enabled (scans), label, gain (None: SDR_GAIN), hf
    (None: automatic, the Blog V4 and V3 have it), tuner (learned at the first opening). Without a
    receivers file, the SDR_DEVICE one (else the first) is enabled."""
    conf, devs = load_device_conf(), list_devices()
    wanted = CONF["SDR_DEVICE"]
    default = next((d["id"] for d in devs if wanted in (str(d["index"]), d["serial"])), devs[0]["id"] if devs else None)
    for d in devs:
        c = conf.get(d["id"], {})
        d["enabled"] = c.get("enabled", d["id"] == default)
        d["label"] = c.get("label") or c.get("name") or " ".join(x for x in (d["maker"], d["product"]) if x) \
            or d["chip"] or "RTL-SDR"
        d["gain"], d["hf"], d["tuner"] = c.get("gain"), c.get("hf"), c.get("tuner")
    return devs


def coverage_text(tuner, hf):
    """'R828D · 0.5 – 1766 MHz' for the receiver list."""
    name, segs = TUNERS.get(tuner, (None, None))
    if not segs:
        return ""
    if hf:
        segs = [(HF_LOW, segs[0][1])] + segs[1:] if segs[0][0] <= 24e6 else [(HF_LOW, 24e6)] + segs
    return "%s · %s MHz" % (name, ", ".join("%g – %g" % (a / 1e6, b / 1e6) for a, b in segs))


class RtlSdr:
    def __init__(self, device, gain_db, async_ok=True, hf=None):
        self.lib = lib = rtl_lib()
        self.stream = None            # continuous stream while the scan stays on one frequency
        self.async_ok = async_ok      # SDR_ASYNC=0: blocking reads only

        if lib.rtlsdr_get_device_count() == 0:
            raise RuntimeError(T("L_SCN_ERR_NO_DONGLE"))
        index = int(device) if str(device).isdigit() else lib.rtlsdr_get_index_by_serial(str(device).encode())
        if index < 0:
            raise RuntimeError(T("L_SCN_ERR_NOT_FOUND", device))
        self.name = " ".join(x for x in usb_strings(lib, index)[:2] if x)
        self.index = index
        self.dev = ctypes.c_void_p()
        if lib.rtlsdr_open(ctypes.byref(self.dev), index) != 0:
            raise RuntimeError(T("L_SCN_ERR_OPEN", index))
        # The Blog V4 (R828D tuner) has its HF upconverter; its USB strings often say "Generic RTL2832U"
        self.tuner = lib.rtlsdr_get_tuner_type(self.dev)
        self.v4 = "Blog V4" in self.name or self.tuner == 6
        # HF below 24 MHz: the V4's upconverter, else direct sampling where the dongle is wired for it
        self.hf = self.v4 or (hf if hf is not None else "Blog V3" in self.name)
        if self.v4 and "V4" not in self.name:
            self.name = "RTL-SDR Blog V4"
        lib.rtlsdr_set_sample_rate(self.dev, FS)
        lib.rtlsdr_set_agc_mode(self.dev, 0)
        lib.rtlsdr_set_tuner_gain_mode(self.dev, 1)
        n = lib.rtlsdr_get_tuner_gains(self.dev, None)
        gains = (ctypes.c_int * max(n, 1))()
        lib.rtlsdr_get_tuner_gains(self.dev, gains)
        self.gain = None   # gain actually applied (dB), the closest to SDR_GAIN among the tuner's gains
        if n > 0:
            g = min(gains[:n], key=lambda g: abs(g - gain_db * 10))
            lib.rtlsdr_set_tuner_gain(self.dev, g)
            self.gain = g / 10
        self.direct = 0
        self.buf = ctypes.create_string_buffer(1 << 18)

    def coverage(self):
        """[(lo, hi)] in Hz this dongle tunes."""
        segs = list(TUNERS.get(self.tuner, (None, [(24e6, 1766e6)]))[1])
        if self.hf:
            if segs[0][0] <= 24e6:
                segs[0] = (HF_LOW, segs[0][1])
            else:
                segs.insert(0, (HF_LOW, 24e6))
        return segs

    def tune(self, hz):
        self.stop_stream()
        # Below 24 MHz: the Blog V4 has its HF upconverter, an R820T switches to Q direct sampling
        direct = 2 if hz < 24e6 and not self.v4 else 0
        if direct != self.direct:
            self.lib.rtlsdr_set_direct_sampling(self.dev, direct)
            self.direct = direct
        self.lib.rtlsdr_set_center_freq(self.dev, int(hz))
        self.lib.rtlsdr_reset_buffer(self.dev)
        self.read(int(FS * 0.03), None)   # the PLL settles: drop 30 ms

    def start_stream(self):
        """Continuous reading from here on (until the next tune): the USB transfers stay queued, no
        sample is lost between two reads nor while a block is analysed."""
        if self.stream or not self.async_ok:
            return
        st = {"chunks": [], "bytes": 0, "cond": threading.Condition(), "done": False, "got": False}

        def on_data(buf, n, _ctx):
            data = ctypes.string_at(buf, n)
            with st["cond"]:
                st["chunks"].append(data)
                st["bytes"] += n
                st["got"] = True
                while st["bytes"] > STREAM_MAX_S * FS * 2 and len(st["chunks"]) > 1:
                    st["bytes"] -= len(st["chunks"].pop(0))
                st["cond"].notify()

        def run():
            self.lib.rtlsdr_read_async(self.dev, st["cb"], None, STREAM_BUFS, STREAM_BUF_BYTES)
            with st["cond"]:
                st["done"] = True
                st["cond"].notify_all()

        st["cb"] = ASYNC_CB(on_data)     # must outlive the stream
        st["thread"] = threading.Thread(target=run, daemon=True)
        self.stream = st
        st["thread"].start()

    def stop_stream(self):
        st, self.stream = self.stream, None
        if st:
            # a cancel sent before read_async has started is lost: repeat it until the thread ends
            for _ in range(30):
                self.lib.rtlsdr_cancel_async(self.dev)
                st["thread"].join(0.1)
                if not st["thread"].is_alive():
                    break
            self.lib.rtlsdr_reset_buffer(self.dev)

    def _read_stream(self, need, stop):
        """need bytes from the stream; None if stop is set; False if the stream died without data (the
        caller goes back to blocking reads)."""
        st, out = self.stream, bytearray()
        deadline = time.time() + 2
        with st["cond"]:
            while len(out) < need:
                if stop is not None and stop.is_set():
                    return None
                if st["chunks"]:
                    chunk = st["chunks"].pop(0)
                    take = need - len(out)
                    out += chunk[:take]
                    if len(chunk) > take:
                        st["chunks"].insert(0, chunk[take:])
                    st["bytes"] -= min(len(chunk), take)
                    deadline = time.time() + 2
                    continue
                if st["done"] or time.time() > deadline:
                    if not st["got"]:
                        return False
                    raise RuntimeError(T("L_SCN_ERR_READ"))
                st["cond"].wait(0.1)
        return bytes(out)

    @staticmethod
    def _iq(raw):
        iq = np.frombuffer(raw, dtype=np.uint8).astype(np.float32)
        iq = (iq - 127.4) / 128.0
        return iq[0::2] + 1j * iq[1::2]

    def read(self, n_samples, stop):
        """n_samples complex samples, or None if stop is set between two blocks."""
        if self.stream:
            raw = self._read_stream(n_samples * 2, stop)
            if raw is None or raw is not False:
                return None if raw is None else self._iq(raw)
            self.stop_stream()          # no data at all: this librtlsdr cannot stream, blocking reads
            self.async_ok = False
        out, need, n_read = bytearray(), n_samples * 2, ctypes.c_int()
        while len(out) < need:
            if stop is not None and stop.is_set():
                return None
            chunk = min(len(self.buf), (need - len(out) + 511) // 512 * 512)
            if self.lib.rtlsdr_read_sync(self.dev, self.buf, chunk, ctypes.byref(n_read)) < 0:
                raise RuntimeError(T("L_SCN_ERR_READ"))
            out += self.buf.raw[:n_read.value]
        return self._iq(bytes(out[:need]))

    def close(self):
        self.stop_stream()
        if self.dev:
            self.lib.rtlsdr_close(self.dev)
            self.dev = None


# --- Detection -----------------------------------------------------------------------------------

def local_floor(p, block=FLOOR_BINS):
    """Noise floor bin by bin: median of blocks of FLOOR_BINS bins, interpolated. A narrow signal is a
    small part of its block; the roll-off of the dongle's filter lowers the edges of the capture, which a
    single median would count as "below the noise"."""
    n = len(p) // block
    if n < 2:
        return np.full(len(p), np.median(p))
    med = np.median(p[:n * block].reshape(n, block), axis=1)
    return np.interp(np.arange(len(p)), (np.arange(n) + 0.5) * block, med)


def longest_run(mask):
    best = cur = 0
    for v in mask:
        cur = cur + 1 if v else 0
        best = max(best, cur)
    return best


def fill_gaps(mask, gap):
    """Fills the holes of at most gap frames between two True: the pauses between words (SSB, no
    carrier) do not cut a transmission."""
    out = np.array(mask, bool)
    idx = np.flatnonzero(out)
    for a, b in zip(idx[:-1], idx[1:]):
        if 1 < b - a <= gap + 1:
            out[a:b] = True
    return out


def run_bounds(mask):
    """Start and end (excluded) of the longest run of True."""
    best, start, cur_start = (0, 0), None, None
    for i, v in enumerate(list(mask) + [False]):
        if v and cur_start is None:
            cur_start = i
        elif not v and cur_start is not None:
            if i - cur_start > best[1] - best[0]:
                best = (cur_start, i)
            cur_start = None
    return best


def voice_features(audio, rate):
    """(syllable/pause gap in dB, share of the 2-10 Hz modulation, share of the 300-3000 Hz energy,
    share of voiced frames)."""
    hop = int(rate * 0.02)
    n = len(audio) // hop
    if n < 40:
        return 0.0, 0.0, 0.0, 0.0
    frames = audio[:n * hop].reshape(n, hop) * np.hanning(hop)
    spec = np.abs(np.fft.rfft(frames, axis=1)) ** 2
    f = np.fft.rfftfreq(hop, 1 / rate)
    band = spec[:, (f >= 300) & (f <= 3000)].sum(axis=1)
    total = spec[:, f >= 100].sum(axis=1) + 1e-20
    band_ratio = float(band.sum() / total.sum())
    e = 10 * np.log10(band + 1e-20)
    dyn = float(np.percentile(e, 90) - np.percentile(e, 15))
    env = e - e.mean()
    mspec = np.abs(np.fft.rfft(env * np.hanning(n))) ** 2
    mf = np.fft.rfftfreq(n, 0.02)
    syll = mspec[(mf >= 2) & (mf <= 10)].sum()
    mod_ratio = float(syll / (mspec[(mf >= 0.5) & (mf <= 25)].sum() + 1e-20))
    return dyn, mod_ratio, band_ratio, voiced_ratio(audio, rate)


def voiced_ratio(audio, rate):
    """Share of the 40 ms frames (the loudest half) periodic between 80 and 400 Hz: normalised
    autocorrelation > 0.5 at a lag of 2.5 to 12.5 ms, the pitch of the voice."""
    hop = int(rate * 0.04)
    n = len(audio) // hop
    if n < 8:
        return 0.0
    fr = audio[:n * hop].reshape(n, hop)
    fr = fr - fr.mean(axis=1, keepdims=True)
    energy = (fr ** 2).sum(axis=1)
    fr = fr[energy > np.percentile(energy, 50)]
    ac = np.fft.irfft(np.abs(np.fft.rfft(fr, 2 * hop, axis=1)) ** 2, axis=1)[:, :hop]
    r = ac[:, int(rate / 400):int(rate / 80)].max(axis=1) / (ac[:, 0] + 1e-20)
    return float((r > 0.5).mean())


def demodulate(z, kind, rate):
    if kind == "fm":
        a = np.angle(z[1:] * np.conj(z[:-1]))
    elif kind == "am":
        a = np.abs(z)
    else:   # ssb: z is centred on the suppressed carrier, the real part gives the audio
        a = z.real
    a = a - a.mean()
    # Light de-emphasis (FM) / noise reduction: ~3.5 kHz low-pass by moving average
    k = max(1, int(rate / 7000))
    return np.convolve(a, np.ones(k) / k, mode="same").astype(np.float32)


class Detector:
    """Memory of a scan: continuous carriers seen at the previous passes."""

    def __init__(self, threshold_db=8.0):
        self.threshold = threshold_db
        self.continuous = {}     # 6.25 kHz key → number of passes where the signal was there the whole time
        self.ignored = set()
        self.quiet = {}          # 6.25 kHz key → pass until which the survey does not listen to this signal again
        self.rules = None        # FreqRules of the store: banned and whitelisted frequencies

    def whitelisted(self, freq):
        return self.rules is not None and self.rules.whitelisted(freq)

    def banned(self, freq):
        return self.rules is not None and self.rules.banned(freq)

    def is_quiet(self, freq, passes):
        k = int(round(freq / 6250))
        return any(self.quiet.get(j, -1) > passes for j in (k - 1, k, k + 1))

    def after_listen(self, signals, passes):
        """After a listen: what did not speak is muted for a few passes, longer if it was transmitting
        continuously; what spoke will be listened to again at the next survey."""
        for sig in signals:
            k = int(round(sig["freq"] / 6250))
            if sig["voice"]:
                self.quiet.pop(k, None)
            elif not sig.get("station"):
                n = QUIET_PASSES[2] if sig["continuous"] else \
                    QUIET_PASSES[1] if sig["occupancy"] >= CONT_OCCUPANCY else QUIET_PASSES[0]
                self.quiet[k] = passes + n

    def survey(self, iq, tuned, lo, hi):
        """Survey: narrow peaks above the threshold in [lo, hi] (mean spectrum of a short hop).
        Returns (spectrum for the display, [(frequency, dB above noise)])."""
        n_frame = int(FS * FRAME_S)
        n_frames = max(1, len(iq) // n_frame)
        segs = len(iq) // NFFT
        win = np.hanning(NFFT).astype(np.float32)
        P = (np.abs(np.fft.fft(iq[:segs * NFFT].reshape(segs, NFFT) * win, axis=1)) ** 2)
        P = np.fft.fftshift(P, axes=1)
        Pmean = P.mean(axis=0)
        Pmax = P.reshape(n_frames, -1, NFFT).mean(axis=1).max(axis=0) if segs % n_frames == 0 else Pmean
        freqs = tuned + (np.arange(NFFT) - NFFT // 2) * FS / NFFT
        dc = np.abs(freqs - tuned) < 3 * FS / NFFT
        keep = (freqs >= lo) & (freqs <= hi)
        kernel = np.ones(SMOOTH_BINS) / SMOOTH_BINS
        clean = Pmean.copy()
        clean[dc] = np.median(Pmean[~dc])
        floor = local_floor(clean)
        S = 10 * np.log10(np.convolve(np.maximum(Pmean, Pmax), kernel, mode="same") / floor + 1e-12)
        S[dc] = 0.0
        Sk, fk = S[keep], freqs[keep]
        cands, taken = [], np.zeros(len(fk), bool)
        for k in np.argsort(-Sk):
            if Sk[k] < self.threshold:
                break
            if taken[max(0, k - 5):k + 6].any():
                continue
            a = b = k
            while a > 0 and Sk[a - 1] > Sk[k] - 10:
                a -= 1
            while b < len(fk) - 1 and Sk[b + 1] > Sk[k] - 10:
                b += 1
            taken[a:b + 1] = True
            if (b - a + 1) * FS / NFFT <= MAX_WIDTH_HZ:      # wide signals are not conversations
                cands.append((float(fk[k]), float(Sk[k])))
        mean = 10 * np.log10(np.convolve(Pmean, kernel, mode="same") / floor + 1e-12)
        mean[dc] = 0.0
        disp = self._display(fk, mean[keep][None, :], np.array([True]))
        disp["peak"] = self._display(fk, Sk[None, :], np.array([True]))["mean"]
        return disp, sorted(cands)

    def analyze(self, iq, tuned, lo, hi, band):
        """Returns (spectrum for the display, list of signals) for the window [lo, hi]."""
        n_frame = int(FS * FRAME_S)
        n_frames = len(iq) // n_frame
        segs = n_frame // NFFT
        win = np.hanning(NFFT).astype(np.float32)
        x = iq[:n_frames * n_frame].reshape(n_frames, n_frame)[:, :segs * NFFT].reshape(n_frames, segs, NFFT)
        P = (np.abs(np.fft.fft(x * win, axis=2)) ** 2).mean(axis=1)
        P = np.fft.fftshift(P, axes=1)
        freqs = tuned + (np.arange(NFFT) - NFFT // 2) * FS / NFFT
        if band.mode == "WFM":
            return self._stations(iq, tuned, lo, hi, P, freqs)
        keep = (freqs >= lo) & (freqs <= hi)
        P, freqs = P[:, keep], freqs[keep]
        kernel = np.ones(SMOOTH_BINS) / SMOOTH_BINS
        Ps = np.apply_along_axis(lambda r: np.convolve(r, kernel, mode="same"), 1, P)
        floor = np.median(P, axis=1, keepdims=True)
        S = 10 * np.log10(Ps / floor + 1e-12)
        on = S > self.threshold
        good = on.mean(axis=1) < BROADBAND_FRAC        # frames without broadband interference
        if good.sum() < max(3, n_frames // 3):
            return self._display(freqs, S, good), []
        on_good = on & good[:, None]
        occupancy = on_good[good].mean(axis=0)
        Smax = np.where(good[:, None], S, -50).max(axis=0)

        min_frames = int(MIN_TX_S / FRAME_S)
        half = 5   # peaks at least ±6 kHz apart
        signals, X = [], None
        order = np.argsort(-Smax)
        taken = np.zeros(len(freqs), bool)
        for k in order:
            if Smax[k] < self.threshold:
                break
            if taken[max(0, k - half):k + half + 1].any():
                continue
            taken[k] = True
            tx = fill_gaps(on_good[:, k], int(HANG_S / FRAME_S))
            tx_s = longest_run(tx) * FRAME_S
            white = self.whitelisted(freqs[k])    # whitelisted: captured as soon as it is above the threshold
            if tx_s < MIN_TX_S - 1e-9 and not white:
                continue      # pulse, data burst, brief interference
            # Width at -10 dB from the peak: a voice channel is narrower than 30 kHz
            lvl = Smax[k] - 10
            a = k
            while a > 0 and Smax[a - 1] > lvl:
                a -= 1
            b = k
            while b < len(freqs) - 1 and Smax[b + 1] > lvl:
                b += 1
            taken[a:b + 1] = True
            lin = 10 ** (Smax[a:b + 1] / 10)
            centroid = float((freqs[a:b + 1] * lin).sum() / lin.sum())
            width = (b - a + 1) * FS / NFFT
            if X is None:
                X = np.fft.fft(iq)
            if width > MAX_WIDTH_HZ and not white:
                sig = {"freq": centroid, "snr": float(Smax[k]), "occupancy": float(occupancy[k]),
                       "tx_s": tx_s, "width": width,
                       "voice": False, "continuous": False, "score": 0.0, "demod": "", "mode": band.mode,
                       "reason": T("L_SCN_REASON_WIDE", width / 1000)}
                self._capture(X, len(iq), tuned, centroid, "fm", tx, sig)
                signals.append(sig)
                continue
            key = int(round(centroid / 6250))
            sig = {"freq": centroid, "snr": float(Smax[k]), "occupancy": float(occupancy[k]),
                   "tx_s": tx_s, "width": width,
                   "voice": False, "continuous": key in self.ignored and not white, "score": 0.0, "demod": "",
                   "mode": band.mode, "reason": T("L_SCN_REASON_CONTINUOUS")}
            signals.append(sig)
            if sig["continuous"]:
                self._capture(X, len(iq), tuned, centroid, "am" if band.mode == "AM" else "fm", tx, sig)
            else:
                self._voice(X, len(iq), tuned, tx, band, sig)
            if white and not sig["voice"]:
                # a false positive for the user: captured (and recorded) like speech
                sig.update(voice=True, whitelisted=True, reason=None, freq=sig.get("center", sig["freq"]))
            sig["key"] = key
        return self._display(freqs, S, good), signals

    def track(self, signals):
        """Once per listen, after its last analysis. Continuous carrier: present during the whole listen at
        CONT_VISITS listens in a row, WITHOUT speech (a long exchange on a repeater also fills the whole
        listen, several times in a row)."""
        for sig in signals:
            key = sig.get("key")
            if key is None:
                continue
            if sig["voice"] or sig["occupancy"] < 0.5:
                self.continuous.pop(key, None)
                self.ignored.discard(key)
            elif sig["occupancy"] >= CONT_OCCUPANCY:
                self.continuous[key] = self.continuous.get(key, 0) + 1
                if self.continuous[key] >= CONT_VISITS:
                    self.ignored.add(key)
            else:
                self.continuous.pop(key, None)

    def _voice(self, X, n, tuned, on_frames, band, sig):
        """Demodulates the signal in every plausible way for the range, keeps the most "speech-like"."""
        f0, f1 = run_bounds(on_frames)
        rate = 2 * AUDIO_HALF_BW
        tries = [("fm", sig["freq"], "NFM"), ("am", sig["freq"], "AM")]
        if band.mode in ("USB", "LSB"):
            # SSB speech: ~300-2700 Hz on one side of the suppressed carrier, which GQRX tunes to.
            # FM and AM are still tried: 10 m and 6 m also have FM segments.
            carrier = sig["freq"] - 1500 if band.mode == "USB" else sig["freq"] + 1500
            tries.insert(0, ("ssb", carrier, band.mode))
        df = FS / n
        half = int(AUDIO_HALF_BW / df)
        t0, t1 = int(f0 * FRAME_S * rate), int(f1 * FRAME_S * rate)
        best = None
        for kind, center, mode in tries:
            # Channel extraction in the frequency domain: a ±8 kHz slice of the FFT of the whole
            # capture, inverse transform = baseband signal at 16 kHz
            c = int(round((center - tuned) / df))
            z = np.fft.ifft(np.fft.ifftshift(X[np.arange(c - half, c + half) % n]))[t0:t1]
            feats = voice_features(demodulate(z, kind, rate), rate)
            dyn, mod, bandr, voiced = feats
            score = min(dyn / VOICE_DYN_DB, mod / VOICE_MOD_RATIO, bandr / VOICE_BAND_RATIO,
                        voiced / VOICE_PITCH_RATIO)
            if best is None or score > best[0]:
                best = (score, kind, center, mode, feats)
        sig["score"], kind, center, sig["mode"], sig["features"] = best
        sig["demod"] = kind
        sig["voice"] = best[0] >= 1.0
        sig["peak"], sig["center"] = sig["freq"], center   # the energy / the SSB carrier, 1.5 kHz beside it
        self._capture(X, n, tuned, center, kind, on_frames, sig)
        if not sig["voice"]:
            sig["reason"] = T("L_SCN_REASON_NO_VOICE", best[0])
            return
        sig["freq"] = center
        sig["reason"] = None

    @staticmethod
    def _capture(X, n, tuned, center, kind, on_frames, sig):
        """The audio of the whole capture, silent outside the transmission (the FM noise between two
        stretches of speech would cover everything), to play back what triggered the detection."""
        rate = 2 * AUDIO_HALF_BW
        df = FS / n
        half = int(AUDIO_HALF_BW / df)
        c = int(round((center - tuned) / df))
        audio = demodulate(np.fft.ifft(np.fft.ifftshift(X[np.arange(c - half, c + half) % n])), kind, rate)
        gate = np.repeat(on_frames, int(FRAME_S * rate))[:len(audio)]
        audio = audio[:len(gate)] * gate
        peak = np.abs(audio).max()
        sig["gain"] = 0.9 / peak if peak > 0 else 1.0      # the recording that follows keeps the same level
        sig["audio"] = audio * sig["gain"]

    def _stations(self, iq, tuned, lo, hi, P, freqs):
        """FM radio stations: ±75 kHz channels on the 100 kHz raster, above the threshold during the whole
        listen, stronger than their neighbours at ±100 kHz and occupied over their whole width (not a line)."""
        P = P.copy()
        dc = np.flatnonzero(np.abs(freqs - tuned) < 3 * FS / NFFT)
        P[:, dc] = P[:, dc.max() + 1][:, None]           # the DC spike can fall in a station at the edge
        # a station at the edge of the window spills over: keep what the capture sees beyond it
        usable = (freqs >= lo - FM_RASTER - FM_HALF_BW) & (freqs <= hi + FM_RASTER)
        P, freqs = P[:, usable], freqs[usable]
        floor = np.percentile(P, 20, axis=1, keepdims=True)   # the band is full: the noise is at the bottom
        rel = P / floor
        # the raster spills over by one channel on each side: a station centred just outside the window must
        # not pass its flank off as a station (it is counted in the neighbouring window)
        grid = np.arange(np.ceil((lo - FM_RASTER) / FM_RASTER) * FM_RASTER, hi + FM_RASTER + 1, FM_RASTER)
        chan, fill = [], []
        for g in grid:
            m = np.abs(freqs - g) <= FM_HALF_BW
            chan.append(10 * np.log10(rel[:, m].mean(axis=1)))        # channel power, frame by frame
            fill.append(float((10 * np.log10(rel[:, m].mean(axis=0)) > self.threshold / 2).mean()))
        chan = np.array(chan) if len(grid) else np.zeros((0, P.shape[0]))
        snr = chan.mean(axis=1) if len(grid) else np.zeros(0)
        signals, X = [], None
        for i, g in enumerate(grid):
            if not lo <= g < hi:
                continue
            near = [j for j in range(len(grid)) if 0 < abs(grid[j] - g) <= FM_RASTER]
            occ = float((chan[i] > self.threshold).mean())
            if snr[i] < self.threshold or occ < FM_MIN_OCCUPANCY or fill[i] < 0.5:
                continue
            if any(snr[j] > snr[i] or (snr[j] == snr[i] and j < i) for j in near):
                continue   # the neighbouring channel is the centre of the station
            sig = {"freq": float(g), "snr": float(snr[i]), "occupancy": occ, "tx_s": len(iq) / FS,
                   "width": 2 * FM_HALF_BW, "voice": False, "station": True, "continuous": False,
                   "score": 0.0, "demod": "wfm", "mode": "WFM", "reason": None}
            if X is None:
                X = np.fft.fft(iq)
            sig["audio"] = self._wfm_audio(X, len(iq), tuned, g)
            signals.append(sig)
        keep = (freqs >= lo) & (freqs <= hi)
        kernel = np.ones(SMOOTH_BINS) / SMOOTH_BINS
        S = 10 * np.log10(np.apply_along_axis(lambda r: np.convolve(r, kernel, mode="same"), 1, rel[:, keep]))
        return self._display(freqs[keep], S, np.ones(len(S), bool)), signals

    @staticmethod
    def _wfm_audio(X, n, tuned, f, rate=2 * AUDIO_HALF_BW):
        """Mono excerpt of the station: FM demodulation over ±100 kHz, 50 µs de-emphasis, audio at 16 kHz."""
        df = FS / n
        c, half = int(round((f - tuned) / df)), int(100_000 / df)
        z = np.fft.ifft(np.fft.ifftshift(X[np.arange(c - half, c + half) % n]))
        a = np.angle(z[1:] * np.conj(z[:-1]))
        A = np.fft.fftshift(np.fft.fft(a - a.mean()))
        fa = (np.arange(len(a)) - len(a) // 2) * (2 * half * df) / len(a)
        A = A / (1 + 2j * np.pi * fa * 50e-6)
        m = len(a) // 2
        k = int(len(a) * rate / (2 * half * df)) // 2
        audio = np.fft.ifft(np.fft.ifftshift(A[m - k:m + k])).real
        peak = np.abs(audio).max()
        return (audio / peak * 0.9 if peak > 0 else audio).astype(np.float32)

    @staticmethod
    def _display(freqs, S, good):
        rows = S[good] if good.any() else S
        mean = rows.mean(axis=0)
        peak = rows.max(axis=0)
        step = max(1, len(freqs) // 600)
        n = len(freqs) // step * step
        return {"freqs": freqs[:n].reshape(-1, step).mean(axis=1),
                "mean": mean[:n].reshape(-1, step).mean(axis=1),
                "peak": peak[:n].reshape(-1, step).max(axis=1)}


