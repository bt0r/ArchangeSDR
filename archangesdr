def migrate_old_name():
    """The program was called SDRScanner: its standalone folders (~/.config/sdrscanner,
    ~/.local/share/sdrscanner) move to the new name, item by item (install.sh has already created
    ~/.local/share/archangesdr/app; the old app/ is install.sh's to remove), and the paths written in the
    history and the settings follow. Nothing to do once moved, or for the desktop profiles."""
    moves = ((os.path.join(_CONFIG, "sdrscanner"), os.path.join(_CONFIG, "archangesdr")),
             (os.path.join(_DATA, "sdrscanner"), os.path.join(_DATA, "archangesdr")))
    for old, new in moves:
        if not os.path.isdir(old):
            continue
        os.makedirs(new, exist_ok=True)
        for name in os.listdir(old):
            if name == "app":
                continue
            dst = os.path.join(new, "archangesdr.conf" if name == "sdrscanner.conf" else name)
            if not os.path.exists(dst):
                try:
                    os.rename(os.path.join(old, name), dst)
                except OSError:
                    pass
        try:
            os.rmdir(old)            # empty now (unless the old app/ is still there)
        except OSError:
            pass
    old_data, new_data = moves[1]
    db = os.path.join(new_data, "scanner.db")
    if os.path.isfile(db):           # the clips and recordings are referenced by their full path
        try:
            con = sqlite3.connect(db)
            for table, col in (("detections", "audio"), ("detections", "recording"), ("freq_rules", "audio")):
                try:
                    con.execute("UPDATE %s SET %s = REPLACE(%s, ?, ?) WHERE %s LIKE ?" % (table, col, col, col),
                                (old_data + "/", new_data + "/", old_data + "/%"))
                except sqlite3.OperationalError:
                    pass             # an older history without that table or column
            con.commit()
            con.close()
        except sqlite3.Error:
            pass
    settings = os.path.join(moves[0][1], "settings.json")
    try:
        text = open(settings, encoding="utf-8").read()
        if old_data + "/" in text:   # the whisper model, under the old data folder
            with open(settings, "w", encoding="utf-8") as f:
                f.write(text.replace(old_data + "/", new_data + "/"))
    except OSError:
        pass


def pick_profile(argv):
    """--profile P, else ARCHANGESDR_PROFILE (or the former SDRSCANNER_PROFILE), else the desktop whose
    settings file exists."""
    if "--profile" in argv:
        i = argv.index("--profile")
        name = argv[i + 1] if i + 1 < len(argv) else ""
        del argv[i:i + 2]
    else:
        name = os.environ.get("ARCHANGESDR_PROFILE") or os.environ.get("SDRSCANNER_PROFILE", "")
    if name not in PROFILES:
        name = "ubonsole" if os.path.isfile(PROFILES["ubonsole"]["conf"]) else \
            "archsdr" if os.path.isdir(os.path.dirname(PROFILES["archsdr"]["conf"])) else "standalone"
    return name


