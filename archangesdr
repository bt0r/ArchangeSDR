def band_color(label, color=None):
    """'RRGGBB' of a range: its own, else one of the palette."""
    if color:
        return color
    return PALETTE[sum(map(ord, label or "")) % len(PALETTE)]


class Band:
    def __init__(self, lo, hi, label, mode, section, enabled=None, color=None):
        self.lo, self.hi, self.label, self.mode, self.section = lo, hi, label, mode, section
        self.color = color
        self.key = "%d-%d" % (lo, hi)
        # HF: unchecked by default, and the very large ranges (23 cm: 60 windows) too. Broadcast ranges
        # (continuous carriers, nothing to "detect") are already unchecked in the default ranges file.
        self.default = lo >= 24e6 and hi - lo <= 20e6
        self.enabled = self.default if enabled is None else enabled

    def to_dict(self):
        d = {"label": self.label, "lo_mhz": self.lo / 1e6, "hi_mhz": self.hi / 1e6, "mode": self.mode,
             "section": self.section, "enabled": self.enabled}
        if self.color:
            d["color"] = self.color
        return d

    @classmethod
    def from_dict(cls, d):
        return cls(float(d["lo_mhz"]) * 1e6, float(d["hi_mhz"]) * 1e6, d.get("label") or "", d["mode"],
                   d.get("section") or T("L_SCN_MY_RANGES"), bool(d.get("enabled", True)), d.get("color"))

    def hops(self):
        """Survey hops (centre, start, end, wide) covering the range, each with its own interval: the
        intervals do not overlap, so two receivers never analyse the same frequency. A narrow range is
        seen in a single hop, tuned just above it (DC spike outside the range); otherwise the DC spike
        falls inside the hop, and ScanState.tuned moves it from one visit to the next."""
        if self.hi - self.lo <= SURVEY_HALF - DC_GAP:
            yield self.hi + DC_GAP, self.lo, self.hi, False
            return
        c = self.lo + SURVEY_HALF
        while c - SURVEY_HALF < self.hi:
            yield c, max(self.lo, c - SURVEY_HALF), min(self.hi, c - SURVEY_HALF + SURVEY_STEP), True
            c += SURVEY_STEP

    def describe(self):
        return "%s – %s · %s" % (fmt_mhz(self.lo, 3), fmt_mhz(self.hi, 3), self.label)


def default_ranges_paths(region=None, lang=None):
    """Default ranges files, best first: the desktop's own (uBonsole generates them with its frequency
    sheets), then ranges/ next to the program; each as <region>/<lang>, <region>/en, eu/<lang>, eu/en."""
    region, lang = region or CONF["REGION"], lang or CONF["LANG"]
    dirs = [d for d in (PROFILE["defaults"], os.path.join(APP_DIR, "ranges")) if d]
    return [os.path.join(d, f + ".json") for d in dirs
            for f in ("%s/%s" % (region, lang), "%s/en" % region, "eu/%s" % lang, "eu/en")]


def default_ranges_path():
    return next((p for p in default_ranges_paths() if os.path.isfile(p)), default_ranges_paths()[0])


def regions():
    """The regions that have default ranges (folders of ranges/ and of the desktop's sheets)."""
    dirs = [d for d in (PROFILE["defaults"], os.path.join(APP_DIR, "ranges")) if d and os.path.isdir(d)]
    return sorted({r for d in dirs for r in os.listdir(d) if os.path.isdir(os.path.join(d, r))})


def load_default_ranges(region=None, lang=None):
    """Default ranges of the region and language (generated with the frequency sheets); [] if missing."""
    for path in default_ranges_paths(region, lang):
        try:
            return [Band.from_dict(d) for d in json.load(open(path, encoding="utf-8"))]
        except (OSError, ValueError, KeyError, TypeError):
            continue
    return []


def load_ranges():
    """Scanner ranges of the profile, copied from the default ranges on first start."""
    try:
        return [Band.from_dict(d) for d in json.load(open(RANGES, encoding="utf-8"))]
    except (OSError, ValueError, KeyError, TypeError):
        bands = load_default_ranges()
        if bands:
            save_ranges(bands)
        return bands


def save_ranges(bands):
    os.makedirs(os.path.dirname(RANGES), exist_ok=True)
    tmp = RANGES + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump([b.to_dict() for b in bands], f, ensure_ascii=False, indent=1)
    os.replace(tmp, RANGES)


def fmt_mhz(hz, decimals=4):
    return ("%%.%df MHz" % decimals) % (hz / 1e6)


