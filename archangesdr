        def stop_clip(self):
            if self.player:
                self.player[0].terminate()
                self.player = None

        def play_clip(self, path):
            playing = self.player and self.player[1] == path
            self.stop_clip()
            if not playing:
                for cmd in (["pw-play"], ["paplay"], ["aplay", "-q"]):
                    try:
                        self.player = (subprocess.Popen(cmd + [path], stdout=subprocess.DEVNULL,
                                                        stderr=subprocess.DEVNULL), path)
                        break
                    except FileNotFoundError:
                        continue
            self.refresh_lists()

        def play_button(self, path, text, tip):
            """▶ <text>, or ■ Stop while that file plays."""
            playing = self.player and self.player[1] == path
            bt = icon_button("media-playback-stop-symbolic" if playing else "media-playback-start-symbolic",
                             T("L_SCN_PLAYING_STOP") if playing else text, tip)
            bt.connect("clicked", lambda *_: self.play_clip(path))
            return bt

        def reveal(self, path):
            """Opens the file manager on the file, selected (FileManager1 over D-Bus: Nautilus, Dolphin,
            Thunar, Nemo, PCManFM...), else its folder with xdg-open."""
            def fallback():
                if not launch(["xdg-open", os.path.dirname(path)]):
                    self.substatus.set_text(T("L_SCN_NO_FILE_MANAGER", path))

            def done(bus, res):
                try:
                    bus.call_finish(res)
                except GLib.Error:
                    fallback()
            try:
                bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            except GLib.Error:
                return fallback()
            bus.call("org.freedesktop.FileManager1", "/org/freedesktop/FileManager1", "org.freedesktop.FileManager1",
                     "ShowItems", GLib.Variant("(ass)", ([Gio.File.new_for_path(path).get_uri()], "")), None,
                     Gio.DBusCallFlags.NONE, 5000, None, done)

        def reveal_button(self, *paths):
            """'Open' for the first existing file of paths (the long recording, else the capture)."""
            path = next((f for f in paths if f and os.path.exists(f)), None)
            if not path:
                return None
            bt = icon_button("folder-open-symbolic", T("L_SCN_OPEN"), T("L_SCN_REVEAL_TIP", path))
            bt.connect("clicked", lambda *_: self.reveal(path))
            return bt

