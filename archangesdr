        def rebuild_range_filters(self):
            """The ranges of the range filter (journal) follow the ranges list."""
            items = [(b.label, b.lo, b.hi) for b in self.bands]
            if items == self.f_range_items:
                return
            keep = self.f_range_items[self.f_range.get_selected() - 1] if self.f_range.get_selected() > 0 else None
            self.f_range_items = items
            self.f_range.set_model(Gtk.StringList.new([T("L_SCN_F_RANGE_ALL")] + [b[0] for b in items]))
            self.f_range.set_selected(items.index(keep) + 1 if keep in items else 0)

        def rebuild_scan_filter(self):
            scans = self.store.q("SELECT id, started, ended FROM scans ORDER BY id DESC LIMIT 100")
            ids = [r[0] for r in scans]
            if ids == self.f_scan_ids:
                return
            keep = self.f_scan_ids[self.f_scan.get_selected() - 1] if self.f_scan.get_selected() > 0 else None
            self.f_scan_ids = ids
            self.f_scan.set_model(Gtk.StringList.new([T("L_SCN_F_SCAN_ALL")] + [
                T("L_SCN_F_SCAN", sid, fmt_time(a, DAY_FMT + " " + CLOCK_FMT), duration(a, b)) for sid, a, b in scans]))
            self.f_scan.set_selected(ids.index(keep) + 1 if keep in ids else 0)

        @staticmethod
        def score_class(kind, score):
            """The colour of the frequency: green for clear speech, then yellow, orange, red."""
            if kind == "station":
                return "active-freq"
            score = score or 0
            return "score-good" if score >= 1.6 else "score-ok" if score >= 1.25 else \
                "score-weak" if score >= 1.0 else "score-bad"

