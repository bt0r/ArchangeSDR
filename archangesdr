def _locale_lang():
    lang = (os.environ.get("LANG") or "en")[:2]
    return lang if lang in LANGS else "en"


def _locale_region():
    """The region of the system locale (fr_FR -> fr, en_GB -> uk, es_PE -> sa), else Europe. archSDR's
    radio-menu (common.sh) maps it the same way, so the menu and the scanner agree."""
    cc = re.sub(r"^[a-z]+_([A-Za-z]{2}).*$", r"\1", os.environ.get("LANG") or "").lower()
    if cc == "gb":
        return "uk"
    if cc in ("bo", "ec", "pe", "py", "uy", "ve"):
        return "sa"
    return cc if cc in ("ar", "au", "br", "ca", "cl", "cn", "co", "de", "es", "fr", "jp", "ru", "us") else "eu"


