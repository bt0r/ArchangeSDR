        def stats_range(self):
            """(since, until) of the period chosen."""
            now = time.time()
            midnight = time.mktime(time.localtime(now)[:3] + (0, 0, 0, 0, 0, -1))
            i = self.stats_period.get_selected()
            custom = i == 4
            day = lambda d: time.mktime((d.get_year(), d.get_month(), d.get_day_of_month(), 0, 0, 0, 0, 0, -1))
            for key, mb, cal in self.stats_dates:
                mb.set_sensitive(custom)
                mb.set_label(T(key, fmt_time(day(cal.get_date()), DAY_FMT)))
            if i == 1:
                return midnight, now
            if i in (2, 3):
                return now - (7 if i == 2 else 30) * 86400, now
            if custom:
                start = [day(cal.get_date()) for _, _, cal in self.stats_dates]
                return min(start), max(start) + 86400
            return 0, now + 86400

        def colors(self):
            """Each range's colour: its own, else the palette in the ranges' order (distinct colours for
            the first ten, where a hash of the name would give two ranges the same one)."""
            return {b.label: b.color or PALETTE[i % len(PALETTE)] for i, b in enumerate(self.bands)}

        def refresh_stats(self, devices=False):
            if not hasattr(self, "stats_area"):
                return
            if devices:               # the receivers and ranges seen in the history, for the filters
                for attr, dd, all_key, sql, name in (
                        ("stats_dev_ids", self.stats_devices, "L_SCN_STATS_ALL_DEVICES",
                         "SELECT DISTINCT device FROM detections WHERE kind IN ('voice', 'parasite') "
                         "ORDER BY device IS NULL, device", self.dev_label),
                        ("stats_range_ids", self.stats_ranges, "L_SCN_STATS_RANGE_ALL",
                         "SELECT DISTINCT label FROM detections WHERE kind IN ('voice', 'parasite') AND label "
                         "IS NOT NULL ORDER BY label", lambda x: x)):
                    ids = [r[0] for r in self.store.q(sql)]
                    old = getattr(self, attr)
                    if ids != old:
                        keep = old[dd.get_selected() - 1] if 0 < dd.get_selected() <= len(old) else ""
                        setattr(self, attr, ids)
                        dd.set_model(Gtk.StringList.new([T(all_key)] + [name(x) for x in ids]))
                        dd.set_selected(ids.index(keep) + 1 if keep in ids else 0)
            step = BUCKETS[self.stats_bucket.get_selected()]
            if step != self.settings.get("stats_bucket"):
                self.save(stats_bucket=step)
            self.stats_step = step
            since, until = self.stats_range()
            kinds = "('voice', 'parasite')" if self.stats_parasites.get_active() else "('voice')"
            where, args = "kind IN %s AND last_seen >= ? AND first_seen <= ?" % kinds, [since, until]
            sel = self.stats_devices.get_selected()
            if 0 < sel <= len(self.stats_dev_ids):
                dev = self.stats_dev_ids[sel - 1]
                where += " AND device IS NULL" if dev is None else " AND device = ?"
                args += [] if dev is None else [dev]
            sel = self.stats_ranges.get_selected()
            if 0 < sel <= len(self.stats_range_ids):
                where += " AND label = ?"
                args.append(self.stats_range_ids[sel - 1])
            raw = self.store.q("SELECT CAST(freq / ? AS INTEGER), label, kind, SUM(hits) FROM detections WHERE " +
                               where + " GROUP BY 1, 2, 3 ORDER BY 1", [step] + args)
            buckets = {}
            for b, lbl, kind, hits in raw:     # stacked: the ranges heard there, then the interference
                v = buckets.setdefault(b, {"ranges": {}, "noise": 0})
                if kind == "parasite":
                    v["noise"] += hits
                else:
                    v["ranges"][lbl or "?"] = v["ranges"].get(lbl or "?", 0) + hits
            self.stats_rows = [(b * step, v["ranges"], v["noise"]) for b, v in sorted(buckets.items())]
            order = [b.label for b in self.bands]
            self.stats_labels = sorted({l for _, r, _ in self.stats_rows for l in r},
                                       key=lambda l: (order.index(l) if l in order else len(order), l))
            voice = sum(sum(r.values()) for _, r, _ in self.stats_rows)
            noise = sum(n for _, _, n in self.stats_rows)
            n = len(self.stats_rows)
            text = P("L_SCN_STATS_SUMMARY", n, n, voice, noise) if n else T("L_SCN_STATS_EMPTY")
            if noise:
                worst = max(self.stats_rows, key=lambda r: r[2])
                text += T("L_SCN_STATS_TOP", fmt_freq(worst[0]), worst[2])
            self.stats_summary.set_text(text)
            clear(self.stats_legend)
            colors = self.colors()
            for lbl in self.stats_labels + ([T("L_SCN_STATS_PARASITE_LEGEND")] if noise else []):
                hx = colors.get(lbl) or (band_color(lbl) if lbl in self.stats_labels else "808080")
                lb = Gtk.Label()
                lb.set_markup('<span foreground="#%s">■</span> %s' % (hx, GLib.markup_escape_text(lbl)))
                self.stats_legend.append(lb)
            top = max([sum(r.values()) + nz for _, r, nz in self.stats_rows] or [1])
            # round graduations: a step of 1, 2 or 5 x 10^k, at most 6 of them
            step = next(m * 10 ** k for k in range(12) for m in (1, 2, 5) if -(-top // (m * 10 ** k)) <= 6)
            self.stats_ticks = max(1, -(-top // step))
            self.stats_top = self.stats_ticks * step
            self.stats_area.set_content_width(max(200, self.STATS_X0 + n * self.STATS_BAR + 24))
            self.stats_area.queue_draw()
            self.stats_axis.queue_draw()

        def stats_y(self, h, v):
            top, bottom = self.STATS_PAD
            return h - bottom - v / self.stats_top * (h - top - bottom)

        def draw_stats_axis(self, area, cr, w, h):
            fg = fg_color(area)
            cr.set_font_size(10)
            for k in range(self.stats_ticks + 1):        # the values, right-aligned against the bars
                v = self.stats_top * k / self.stats_ticks
                text = ("%d" % v) if v == int(v) else "%.1f" % v
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.7)
                cr.move_to(w - 4 - cr.text_extents(text).x_advance, self.stats_y(h, v) + 4)
                cr.show_text(text)
            cr.save()
            cr.move_to(12, h - self.STATS_PAD[1] - 4)
            cr.rotate(-np.pi / 2)
            cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.5)
            cr.show_text(T("L_SCN_STATS_AXIS"))
            cr.restore()

        def draw_stats(self, area, cr, w, h):
            fg = fg_color(area)
            for k in range(self.stats_ticks + 1):        # grid
                y = self.stats_y(h, self.stats_top * k / self.stats_ticks)
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.08 if k else 0.3)
                cr.move_to(0, y)
                cr.line_to(w, y)
                cr.stroke()
            bw = self.STATS_BAR
            colors = self.colors()
            cr.set_font_size(10)
            for i, (f, ranges, noise) in enumerate(self.stats_rows):
                x = self.STATS_X0 + i * bw
                base = 0
                for lbl in self.stats_labels + [None]:      # stacked: each range, the interference on top
                    v = noise if lbl is None else ranges.get(lbl, 0)
                    if not v:
                        continue
                    y0, y1 = self.stats_y(h, base), self.stats_y(h, base + v)
                    if lbl is None:
                        cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.35)
                    else:
                        hx = colors.get(lbl) or band_color(lbl)
                        cr.set_source_rgba(*(int(hx[k:k + 2], 16) / 255 for k in (0, 2, 4)), 0.9)
                    cr.rectangle(x + 3, y1, bw - 6, y0 - y1)
                    cr.fill()
                    base += v
                # the frequency under the bar, at 45°, its end under the bar's centre
                text = fmt_freq(f)
                ext = cr.text_extents(text)
                cr.save()
                cr.set_source_rgba(fg.red, fg.green, fg.blue, 0.75)
                cr.translate(x + bw / 2 + 3, self.stats_y(h, 0) + 8)
                cr.rotate(-np.pi / 4)
                cr.move_to(-ext.x_advance, 0)
                cr.show_text(text)
                cr.restore()

        def stats_tooltip(self, area, x, y, keyboard, tooltip):
            i = int((x - self.STATS_X0) // self.STATS_BAR)
            if not 0 <= i < len(self.stats_rows):
                return False
            f, ranges, noise = self.stats_rows[i]
            lines = ["%s – %s" % (fmt_freq(f), fmt_freq(f + self.stats_step))]
            lines += ["%s: %d" % (lbl, v) for lbl, v in sorted(ranges.items(), key=lambda kv: -kv[1])]
            if noise:
                lines.append("%s: %d" % (T("L_SCN_STATS_PARASITE_LEGEND"), noise))
            tooltip.set_text("\n".join(lines))
            return True

