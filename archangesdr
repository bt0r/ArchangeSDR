def load_lang(lang):
    """L_* strings of en.sh, then of <lang>.sh (a missing translation stays in English). The files are
    bash: L_KEY='value', where a literal quote is written '\\''."""
    strings = {}
    for name in ("en", lang) if lang != "en" else ("en",):
        try:
            text = open(os.path.join(APP_DIR, "lang", name + ".sh"), encoding="utf-8").read()
        except OSError:
            continue
        for m in re.finditer(r"^(L_[A-Za-z0-9_]+)=(.*)$", text, re.M):
            raw = m.group(2).strip()
            if re.fullmatch(r"(?:'[^']*'|\\')+", raw):
                strings[m.group(1)] = "".join(tok[1:-1] if tok.startswith("'") else "'"
                                              for tok in re.findall(r"'[^']*'|\\'", raw))
    return strings


