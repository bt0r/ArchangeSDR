        def journal_rows(self):
            where, args = [], []
            if not self.f_parasites.get_active():
                where.append("d.kind != 'parasite'")
            if self.f_dur.get_selected() > 0:
                where.append("COALESCE(d.rec_s, 0) >= ?")
                args.append(DURATIONS[self.f_dur.get_selected()])
            if 0 < self.f_range.get_selected() <= len(self.f_range_items):
                lbl, lo, hi = self.f_range_items[self.f_range.get_selected() - 1]
                where.append("(d.label = ? OR d.freq BETWEEN ? AND ?)")
                args += [lbl, lo, hi]
            if self.f_snr.get_selected() > 0:
                where.append("d.snr >= ?")
                args.append(SNRS[self.f_snr.get_selected()])
            if self.f_score.get_selected() > 0:
                where.append("d.score >= ?")
                args.append(SCORES[self.f_score.get_selected()])
            if 0 < self.f_scan.get_selected() <= len(self.f_scan_ids):
                where.append("d.scan_id = ?")
                args.append(self.f_scan_ids[self.f_scan.get_selected() - 1])
            found = self.store.search_transcripts(self.f_search.get_text())
            if found is not None:
                where.append("d.id IN (%s)" % (",".join(str(int(i)) for i in found) or "NULL"))
            cols = ("id", "freq", "mode", "label", "first_seen", "last_seen", "hits", "snr", "score", "scan_id",
                    "kind", "reason", "audio", "params", "recording", "rec_s", "device")
            rows = self.store.q("SELECT %s, t.status, t.text, t.language, t.engine, t.error FROM detections d "
                                "LEFT JOIN transcripts t ON t.detection_id = d.id %s ORDER BY d.last_seen DESC "
                                "LIMIT 300" % (", ".join("d." + c for c in cols),
                                               "WHERE " + " AND ".join(where) if where else ""), args)
            keys = cols + ("t_status", "t_text", "t_language", "t_engine", "t_error")
            return [dict(zip(keys, r)) for r in rows]

        def refresh_lists(self, *_):
            if not hasattr(self, "journal_tab_label"):     # still being built
                return
            now = time.time()
            self.last_journal = now
            self.rebuild_scan_filter()
            rows = self.journal_rows()
            active_ids = {r["id"] for r in rows if now - r["last_seen"] < (ACTIVE_HOLD_S if r["kind"] == "voice"
                                                                          else STATION_HOLD_S)}
            sig = (tuple(tuple(r.values()) for r in rows), frozenset(active_ids), self.player and self.player[1],
                   self.tr_conf().get("engine"))
            if sig != getattr(self, "journal_sig", None):
                self.journal_sig = sig
                self.fill(self.log_list, [self.det_row(r, now) for r in rows], T("L_SCN_NO_DETECTIONS"))
            active = sum(1 for r in rows if r["kind"] == "voice" and now - r["last_seen"] < ACTIVE_HOLD_S)
            self.journal_tab_label.set_text(T("L_SCN_TAB_LOG_N", active) if active else T("L_SCN_TAB_LOG"))
            self.journal_summary.set_text(P("L_SCN_F_COUNT", len(rows), len(rows)) +
                                          (T("L_SCN_F_LIMIT") if len(rows) >= 300 else ""))
            rules = self.store.q("SELECT freq, mode, label, parasite, banned, whitelisted, last_seen, reason, audio "
                                 "FROM freq_rules ORDER BY banned IS NULL, whitelisted IS NULL, parasite DESC, "
                                 "last_seen DESC LIMIT 300")
            sig = (tuple(rules), self.player and self.player[1])
            if sig != getattr(self, "rules_sig", None):
                self.rules_sig = sig
                self.fill(self.rules_list, [self.rule_row(*r) for r in rules], T("L_SCN_NO_RULES"))
            n = sum(1 for r in rules if r[4])
            self.rules_tab_label.set_text(T("L_SCN_TAB_RULES_N", n) if n else T("L_SCN_TAB_RULES"))
            if self.tabs.get_current_page() == self.stats_page:
                self.refresh_stats()

        def dev_label(self, dev):
            if not dev:
                return T("L_SCN_STATS_DEV_NONE")
            c = load_device_conf().get(dev, {})
            return c.get("label") or c.get("name") or dev

        def dev_suffix(self, dev):
            """' · <receiver>' on the rows, once several receivers have been used."""
            if dev is None or len(load_device_conf()) < 2:
                return ""
            return " · " + self.dev_label(dev)

