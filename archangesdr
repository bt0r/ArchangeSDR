    d = int(d)
    if d < 60:
        return T("L_SCN_DUR_S", d)
    return T("L_SCN_DUR_MIN", d // 60, d % 60) if d < 3600 else T("L_SCN_DUR_H", d // 3600, d % 3600 // 60)


