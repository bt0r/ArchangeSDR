            color: @theme_fg_color; background-image: none; background-color: alpha(@theme_fg_color, 0.08); }
        dropdown > button:hover, menubutton > button:hover { background-color: alpha(@theme_fg_color, 0.15); }
        dropdown > button label, menubutton > button label,
        dropdown > button:checked label, menubutton > button:checked label { color: @theme_fg_color; }
        """

    def css(accent_hex, dark):
        # white text needs a darker accent on a light page (a pastel pink would be 2:1)
        colors = dict(PALETTES[dark], a=accent_hex,
                      primary="#" + accent_hex if dark else "shade(#%s, 0.72)" % accent_hex)
        return ("" if own_theme else DESKTOP_FIX) + """
        .freq { font-family: monospace; font-size: 1.25em; font-weight: bold; }
        .active-freq { color: #%(a)s; }
        .score-good { color: #%(good)s; }
        .score-ok { color: #%(ok)s; }
        .score-weak { color: #%(weak)s; }
        .score-bad { color: #%(bad)s; }
        /* an open drop-down / menu button keeps the text colour (some desktop themes paint it black) */
        dropdown > button:checked, dropdown > button:checked label, menubutton > button:checked,
        menubutton > button:checked label { color: inherit; }
        .badge { color: #%(a)s; font-weight: bold; }
        .dim { opacity: 0.65; }
        .status-title { font-size: 1.1em; font-weight: bold; }
        .card { padding: 10px 12px; border-radius: 8px; background: alpha(currentColor, 0.05); }
        .chip { padding: 2px 6px; border-radius: 8px; background: alpha(currentColor, 0.06); }
        .banner { padding: 8px 12px; border-radius: 8px; border: 1px solid #%(a)s; background: alpha(#%(a)s, 0.12); }
        button.listen { background-image: none; background-color: #%(a)s; color: #%(on_accent)s; font-weight: bold; }
        button.listen:hover { background-color: shade(#%(a)s, 1.1); }
        button.primary { background-image: none; background-color: %(primary)s; color: #FFFFFF; font-weight: bold; }
        button.primary:hover { background-color: shade(%(primary)s, 1.1); }
        button.danger { background-image: none; background-color: #%(danger)s; color: #FFFFFF; font-weight: bold; }
        button.danger:hover { background-color: shade(#%(danger)s, 1.1); }
        button.plain { background-image: none; background-color: alpha(currentColor, 0.12); color: inherit; }
        button.plain:hover { background-color: alpha(currentColor, 0.2); }
        .parasite { opacity: 0.6; }
        .params { font-family: monospace; font-size: 0.85em; }
        .transcript { font-style: italic; }
        .section { font-weight: bold; font-size: 1.05em; margin-top: 10px; }
        """ % colors

    def ago(t):
        d = int(time.time() - t)
        if d < 60:
            return T("L_SCN_AGO_S", d)
        if d < 3600:
            return T("L_SCN_AGO_MIN", d // 60)
        return fmt_time(t, DAY_FMT + " " + CLOCK_FMT)

    def duration(a, b):
        return fmt_secs((b or time.time()) - a)

    _durations = {}

    def wav_seconds(path):
        """Length of a WAV file, cached by path and size (a recording grows when a conversation resumes)."""
        try:
            key = (path, os.path.getsize(path))
        except OSError:
            return 0.0
        if key not in _durations:
            try:
                with wave.open(path, "rb") as w:
                    _durations[key] = w.getnframes() / w.getframerate()
            except (OSError, EOFError, wave.Error):
                _durations[key] = 0.0
        return _durations[key]

    def size_text(mb):
        """'60 MB', '1.1 GB' (the decimal separator of the language)."""
        if mb < 1000:
            return T("L_SCN_MB", round(mb))
        return T("L_SCN_GB", ("%.1f" % (mb / 1000)).replace(".", T("L_SCN_DECIMAL")))

    def short_secs(d):
        """'1,5 s' below 10 s (the decimal separator of the language), else as fmt_secs."""
        if d >= 10:
            return fmt_secs(d)
        return T("L_SCN_DUR_S_DEC", ("%.1f" % d).replace(".", T("L_SCN_DECIMAL")))

    def fmt_freq(f):
        """145.500 MHz / 531 kHz with the decimals the value needs (axis labels)."""
        unit, div = ("MHz", 1e6) if f >= 1e6 else ("kHz", 1e3)
        v = f / div
        d = next((d for d in range(7) if abs(round(v, d) - v) < 1e-9), 6)
        return "%.*f %s" % (d, v, unit)

    def describe_params(raw):
        """(short line, full detail) of the capture parameters stored as JSON."""
        try:
            p = json.loads(raw) if raw else None
        except ValueError:
            p = None
        if not p:
            return None, None
        demod = {"fm": "FM", "am": "AM", "ssb": "SSB"}.get(p.get("demod"), "-")
        gain = "%.1f dB" % p["gain"] if p.get("gain") is not None else T("L_SCN_GAIN_AUTO")
        lo, hi = p["window"]
        short = T("L_SCN_PARAMS_SHORT",
                  p["mode"], demod, lo / 1e6, hi / 1e6, p["tuned"] / 1e6, p["rate"] / 1e6, p["dwell"], gain,
                  p["threshold"], p["snr"], p["tx_s"], p["score"])
        lines = [
            T("L_SCN_PARAMS_FREQ", fmt_mhz(p["freq"]), p["mode"], demod),
            T("L_SCN_PARAMS_WINDOW", lo / 1e6, hi / 1e6, p["tuned"] / 1e6,
              T("L_SCN_PARAMS_DIRECT") if p.get("direct") else ""),
            T("L_SCN_PARAMS_DONGLE", p.get("device") or "?", p["rate"] / 1e6, gain, p["dwell"]),
            T("L_SCN_PARAMS_DETECT", p["threshold"], p["snr"], 100 * p["occupancy"], p["tx_s"], p["width_khz"]),
        ]
        if p.get("features"):
            dyn, mod, band = p["features"][:3]
            line = T("L_SCN_PARAMS_VOICE", p["score"], dyn, VOICE_DYN_DB, mod, VOICE_MOD_RATIO,
                     band, VOICE_BAND_RATIO)
            if len(p["features"]) > 3:
                line += T("L_SCN_PARAMS_VOICED", p["features"][3], VOICE_PITCH_RATIO)
            lines.append(line)
        return short, "\n".join(lines)

    def label(text, css=(), xalign=0.0, **kw):
        lb = Gtk.Label(label=text, xalign=xalign, **kw)
        for c in css:
            lb.add_css_class(c)
        return lb

    def fg_color(widget):
        """The widget's text colour: get_color() from GTK 4.10, the style context before (Debian 12: 4.8)."""
        if hasattr(widget, "get_color"):
            return widget.get_color()
        return widget.get_style_context().get_color()

    def check_label(cb, text, **kw):
        """A check button with a two-line, ellipsized label: set_child() from GTK 4.8, a plain label before
        (Ubuntu 22.04: 4.6)."""
        if hasattr(cb, "set_child"):
            cb.set_child(label(text, ellipsize=Pango.EllipsizeMode.END, **kw))
        else:
            cb.set_label(text)

    def icon_button(icon, text, tip=None, css="plain"):
        """A button with an icon before its text."""
        bt = Gtk.Button(valign=Gtk.Align.CENTER, tooltip_text=tip)
        box = Gtk.Box(spacing=6)
        box.append(Gtk.Image.new_from_icon_name(icon))
        if text:
            box.append(Gtk.Label(label=text))
        bt.set_child(box)
        if css:
            bt.add_css_class(css)
        return bt

    def dropdown(items, selected=0, on_change=None):
        dd = Gtk.DropDown.new_from_strings(list(items))
        dd.set_selected(max(0, min(selected, len(items) - 1)))
        if on_change:
            dd.connect("notify::selected", lambda *_: on_change())
        return dd

    def color_button(hex_color, on_change):
        """A colour picker ('RRGGBB' in and out): ColorDialogButton on GTK >= 4.10, ColorButton before."""
        rgba = Gdk.RGBA()
        rgba.parse("#" + hex_color)
        to_hex = lambda c: "%02X%02X%02X" % tuple(int(round(v * 255)) for v in (c.red, c.green, c.blue))
        if hasattr(Gtk, "ColorDialogButton"):
            bt = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(with_alpha=False), valign=Gtk.Align.CENTER)
            bt.set_rgba(rgba)
            bt.connect("notify::rgba", lambda w, _p: on_change(to_hex(w.get_rgba())))
        else:
            bt = Gtk.ColorButton(rgba=rgba, use_alpha=False, valign=Gtk.Align.CENTER)
            bt.connect("color-set", lambda w: on_change(to_hex(w.get_rgba())))
        return bt

    def modal(parent, title, child):
        dlg = Gtk.Window(title=title, transient_for=parent, modal=True)
        dlg.set_child(child)
        return dlg

    def clear(box):
        while (child := box.get_first_child()) is not None:
            box.remove(child)

    def children(widget):
        child = widget.get_first_child()
        while child is not None:
            yield child
            child = child.get_next_sibling()

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="io.github.bt0r.archangesdr",
                             flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
            self.store = Store()
            self.bands = load_ranges()
            self.settings = load_settings()
            self.scanners = []         # one Scanner per receiver of the scan running
            self.scan_devs = []        # the receivers of the scan running or paused
            self.state = None          # ScanState of the scan running or paused
            self.player = None         # (process, file) of the capture being played
            self.cards = {}            # receiver id (None: no scan) → its "current scan" card
            self.devices = []
            self.after_stop = []
            self.win = None
            self.banner_timer = None   # GLib source that hides the "active frequency" banner
            self.ranges_dialog = None
            self.transcriber = None
            self.last_journal = 0

        # Settings, theme -----------------------------------------------------------------------------
        def save(self, **fields):
            self.settings.update(fields)
            save_settings(self.settings)

        def tr_conf(self):
            return self.settings.setdefault("transcription", {})

        def save_tr(self, **fields):
            self.tr_conf().update(fields)
            save_settings(self.settings)
            if self.transcriber:
                self.transcriber.wake.set()

        def accent_hex(self):
            mode = self.settings.get("accent_mode", "pink")
            if mode == "custom" and re.fullmatch(r"[0-9A-Fa-f]{6}", self.settings.get("accent", "")):
                return self.settings["accent"]
            if mode == "desktop" and desktop_accent:
                return desktop_accent
            return DEFAULT_ACCENT

        def is_dark(self):
            theme = self.settings.get("theme", "dark")
            if theme in ("dark", "light"):
                return theme == "dark"
            # the desktop's: its prefer-dark setting, else the GNOME colour scheme
            st = Gtk.Settings.get_default()
            if st.get_property("gtk-application-prefer-dark-theme"):
                return True
            try:
                out = subprocess.run(["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"],
                                     capture_output=True, text=True, timeout=2).stdout
                return "light" not in out
            except (OSError, subprocess.SubprocessError):
                return True

        def apply_theme(self):
            st = Gtk.Settings.get_default()
            theme = self.settings.get("theme", "dark")
            if st.find_property("gtk-interface-color-scheme"):     # GTK >= 4.20
                schemes = Gtk.InterfaceColorScheme
                st.set_property("gtk-interface-color-scheme", {"dark": schemes.DARK, "light": schemes.LIGHT}
                                .get(theme, getattr(schemes, "DEFAULT", schemes.DARK)))
            elif theme == "system":
                st.reset_property("gtk-application-prefer-dark-theme")
            else:
                st.set_property("gtk-application-prefer-dark-theme", theme == "dark")
            hx = self.accent_hex()
            self.accent = tuple(int(hx[k:k + 2], 16) / 255 for k in (0, 2, 4))
            self.css.load_from_data(css(hx, self.is_dark()).encode())
            for c in self.cards.values():
                c.area.queue_draw()
            if hasattr(self, "stats_area"):
                self.stats_area.queue_draw()

        def do_activate(self):
            if self.win:
                self.win.present()
                return
            self.css = Gtk.CssProvider()
            add = getattr(Gtk, "style_context_add_provider_for_display", None) or \
                Gtk.StyleContext.add_provider_for_display   # GTK < 4.10
            # above the user's gtk.css (USER priority): the app's own colours are not repainted by it
            add(Gdk.Display.get_default(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
            self.apply_theme()
            self.win = Gtk.ApplicationWindow(application=self, title=T("L_SCN_TITLE"))
            self.win.set_decorated(False)   # no title bar: i3 manages the window
            self.win.set_default_size(1280, 680)
            self.build()
            self.win.present()
            GLib.timeout_add_seconds(1, self.tick)
            try:    # GLib >= 2.80 moved it to GLibUnix; the old name is deprecated
                gi.require_version("GLibUnix", "2.0")
                from gi.repository import GLibUnix
                GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.on_usr1)
            except (ImportError, ValueError, AttributeError):
                GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGUSR1, self.on_usr1)
            self.transcriber = Transcriber(self.store, on_done=lambda did: GLib.idle_add(
                lambda: self.refresh_lists() and False))
            self.transcriber.start()
            self.refresh_lists()

        # Construction --------------------------------------------------------------------------------
        @staticmethod
        def scroll_column(child):
            """A column that scrolls when the window is shorter than its content (a tiling window manager
            imposes the height of its tile; GTK would otherwise complain at every frame and cut it off)."""
            sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_width=True,
                                    vexpand=True)
            sw.set_child(child)
            return sw

        def build(self):
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=10, margin_bottom=10,
                           margin_start=10, margin_end=10)
            # In-app alert of a new active frequency: notify-send often has no notification daemon to
            # talk to on the uConsole
            self.banner = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN, reveal_child=False)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            box.add_css_class("banner")
            self.banner_title = label("", ["status-title", "active-freq"])
            self.banner_body = label("", ["dim"], ellipsize=Pango.EllipsizeMode.END, width_chars=10)
            box.append(self.banner_title)
            box.append(self.banner_body)
            self.banner.set_child(box)
            root.append(self.banner)

            # 1. The scan: one card per receiver, the whole width
            self.cards_grid = Gtk.Grid(column_spacing=8, row_spacing=8, column_homogeneous=True)
            root.append(self.cards_grid)
            self.set_cards([])
            self.substatus.set_text(T("L_SCN_IDLE_HINT"))

            # 2. The scan bar, in reading order: receivers, ranges / listen, threshold, Start
            bar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            bar.add_css_class("card")
            row1 = Gtk.Box(spacing=12)
            self.dev_box = Gtk.Box(spacing=6)
            row1.append(self.dev_box)
            self.ranges_btn = icon_button("view-list-symbolic", " ", T("L_SCN_RANGES_BTN_TIP"))
            self.ranges_btn.connect("clicked", lambda *_: self.open_ranges())
            row1.append(self.ranges_btn)
            bar.append(row1)
            row2 = Gtk.Box(spacing=12)
            self.dwell = Gtk.SpinButton.new_with_range(1.0, 10.0, 0.5)
            self.dwell.set_value(float(self.settings.get("dwell", 2.5)))
            self.dwell.set_digits(1)
            self.dwell.connect("value-changed", lambda w: (self.save(dwell=w.get_value()), self.update_estimate()))
            self.threshold = Gtk.SpinButton.new_with_range(4, 30, 1)
            self.threshold.set_value(float(self.settings.get("threshold", 8)))
            self.threshold.connect("value-changed", lambda w: self.save(threshold=w.get_value()))
            for text, w in ((T("L_SCN_DWELL"), self.dwell), (T("L_SCN_THRESHOLD"), self.threshold)):
                b = Gtk.Box(spacing=6)
                b.append(label(text, valign=Gtk.Align.CENTER))
                b.append(w)
                row2.append(b)
            self.estimate = label("", ["dim"], wrap=True, hexpand=True, valign=Gtk.Align.CENTER)
            row2.append(self.estimate)
            self.end_btn = Gtk.Button(label=T("L_SCN_FINISH"), valign=Gtk.Align.CENTER, visible=False)
            self.end_btn.add_css_class("plain")
            self.end_btn.set_tooltip_text(T("L_SCN_FINISH_TIP"))
            self.end_btn.connect("clicked", lambda *_: self.finish_paused())
            row2.append(self.end_btn)
            self.toggle = Gtk.Button(valign=Gtk.Align.CENTER)
            self.toggle.connect("clicked", self.on_toggle)
            self.set_button("start")
            row2.append(self.toggle)
            bar.append(row2)
            root.append(bar)
            self.rebuild_devices()

            # 3. The tabs
            self.tabs = Gtk.Notebook(vexpand=True)
            self.tabs.set_size_request(-1, 220)
            self.journal_page = self.tabs.append_page(self.build_journal(), Gtk.Label(label=T("L_SCN_TAB_LOG")))
            self.rules_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            page.append(label(T("L_SCN_RULES_HINT", BAN_PARASITE), ["dim"], wrap=True, margin_start=8,
                              margin_end=8, margin_top=6, margin_bottom=4))
            sw = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
            sw.set_child(self.rules_list)
            page.append(sw)
            self.rules_page = self.tabs.append_page(page, Gtk.Label(label=T("L_SCN_TAB_RULES")))
            self.stats_page = self.tabs.append_page(self.build_stats(), Gtk.Label(label=T("L_SCN_TAB_STATS")))
            self.tabs.append_page(self.build_settings(), Gtk.Label(label=T("L_SCN_TAB_SETTINGS")))
            self.tabs.connect("switch-page", lambda _n, _p, i: i == self.stats_page and
