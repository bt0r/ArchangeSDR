JOIN_PROGRAMS = (("gqrx", "GQRX", "gqrx"), ("sdrpp", "SDR++", "sdrpp"), ("rtl_fm", "rtl_fm + aplay", "rtl_fm"))
RTL_MODES = {"NFM": "fm", "FM": "fm", "AM": "am", "USB": "usb", "LSB": "lsb", "WFM": "wbfm"}
